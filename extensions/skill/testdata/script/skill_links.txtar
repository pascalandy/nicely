# A subfolder may be a link to a folder elsewhere, as harness skill folders often hold. A
# linked skill is listed once, with the path of the first link that reaches it, and without
# a warning when another link reaches the same folder. A broken link is no skill, and list
# skips it without a warning.
[!symlink] skip
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=
mkdir $WORK/.config/nicely
cp config.toml $WORK/.config/nicely/config.toml
mkdir skills
symlink skills/alpha -> $WORK/store/alpha
symlink skills/broken -> $WORK/nowhere
symlink skills/same -> $WORK/store/alpha
symlink more/again -> $WORK/store/alpha
symlink linked -> $WORK/store

exec ncly skill list --json
answer stdout ok
stdout '^\{"ok":true,"contract_version":1,"skills":\[\{"name":"alpha","description":"Use for alpha\.","path":"'${WORK@R}'/skills/alpha","source":"config"\},\{"name":"gamma","description":"Use for gamma\.","path":"'${WORK@R}'/linked/gamma","source":"config"\}\]\}$'
! stderr .

-- config.toml --
[skill]
paths = ["~/skills", "~/more", "~/linked"]
-- store/alpha/SKILL.md --
---
name: alpha
description: Use for alpha.
---
-- store/gamma/SKILL.md --
---
name: gamma
description: Use for gamma.
---
-- more/.keep --
