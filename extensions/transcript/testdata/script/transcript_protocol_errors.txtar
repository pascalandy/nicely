# An engine that breaks the protocol during execution is RUNTIME, whose item names how it broke.
# Before the ack, the step stays pending with that cause, no folder exists, and the same call
# runs again. After the ack, the step stays unknown, the folder stays, and the same call starts
# nothing. The stub uv answers as $STUB asks, with $STUB as the name of its folder, and appends
# upload to $WORK/uploads.log only where a real engine would upload.
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=
chmod 755 bin/uv
chmod 755 bin/python3
onlyncly transcript-external
env URL=https://www.youtube.com/watch?v=EIEc43CxIvY
env OUT=$WORK/out
mkdir $OUT
env STATE=$WORK/.local/state/nicely
mkdir $STATE
cp seed.jsonl test-keychain.jsonl
exec /bin/sh -c 'printf "{\"format_version\":1,\"grants\":[{\"service\":\"deepgram\",\"domain\":\"transcript\",\"path\":\"%s\",\"granted_at\":\"2026-10-18T04:00:00Z\"}]}\n" "$DATA/ncly-transcript" > "$STATE/grants.json"'

# Before the ack: an intent for another item, of another version, with a name that leaves the
# output folder, or without tools, and a step that only an acknowledged engine may send
env STUB=other
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p1 --json
stderr '"output_dir":null,.*"errors":\[\{"code":"RUNTIME","message":"The plan of the transcript program names another URL or folder than the call\."'
env STUB=version
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p2 --json
stderr '"message":"The transcript program speaks another version of its protocol\."'
env STUB=escape
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p3 --json
stderr '"message":"The transcript program proposed a folder name or tools that Go cannot use\."'
env STUB=notools
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p4 --json
stderr '"message":"The transcript program proposed a folder name or tools that Go cannot use\."'
env STUB=early
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p5 --json
stderr '"message":"The transcript program reported a step that its protocol does not define\."'
exec /bin/ls -A $OUT
! stdout .
exec ncly run view p5 --json
stdout '"output_dir":null,"steps":\[\{"artifacts":\[\],"effect":"paid","error":\{"code":"RUNTIME"[^}]*\},"finished_at":null,"id":"transcribe","started_at":null,"status":"pending"\}\]'
! exists uploads.log

# A dry run under a pending run decides as the call would: an engine that breaks the protocol
# answers RUNTIME under the ID of that run
env STUB=other
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id p1 --dry-run --json
answer stderr RUNTIME
stderr '"run_id":"p1"'

# The same call runs again once the engine keeps the protocol
env STUB=
exec ncly transcript run youtube --url $URL --output $OUT --run-id p5 --json
stdout '"ok":true,"contract_version":1,"run_id":"p5"'

# After the ack: a second intent, a line that is no message, an unknown code, a status that the
# code does not take, an unknown warning, no last step, a second step, and an exit other than 0
# after the step. Each leaves the folder, and the step unknown, so the same call starts nothing
env STUB=twice
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a1 --json
stderr '"output_dir":"'${OUT@R}'/twice",.*"message":"The transcript program sent a message out of order\."'
env STUB=garbage
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a2 --json
stderr '"message":"The transcript program wrote a line that is no message\."'
env STUB=mystery
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a3 --json
stderr '"message":"The transcript program reported a step that its protocol does not define\."'
env STUB=mismatch
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a4 --json
stderr '"message":"The transcript program reported a step that its protocol does not define\."'
env STUB=warning
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a5 --json
stderr '"message":"The transcript program reported a step that its protocol does not define\."'
env STUB=nostep
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a6 --json
stderr '"message":"The transcript program exited without its last step\."'
env STUB=extra
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a7 --json
stderr '"message":"The transcript program sent a message out of order\."'
env STUB=late
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a8 --json
stderr '"message":"The transcript program exited with an error\."'
exec /bin/ls $OUT
stdout '\Aextra\ngarbage\nlate\nmismatch\nmystery\nnostep\nstub\ntwice\nwarning\n\z'
exec ncly run view a8 --json
stdout '"steps":\[\{"artifacts":\[\],"effect":"paid","error":\{"code":"RUNTIME".*"finished_at":null,.*"status":"unknown"\}\]'
stdout '"status":"unknown","tools"'
exits 1 ncly transcript run youtube --url $URL --output $OUT --run-id a8 --json
answer stderr RESUME_UNSAFE
grep -count=9 '(?m)^upload$' uploads.log

-- bin/uv --
#!/bin/sh
IFS= read -r request
out=$(printf '%s\n' "$request" | /usr/bin/sed -n 's/.*"output":"\([^"]*\)".*/\1/p')
name=${STUB:-stub}
msg() { printf '{"protocol_version":%s,"type":"%s","item":"%s","step":"transcribe",%s}\n' "${4:-1}" "$1" "${3:-$URL}" "$2"; }
intent() { msg intent "\"name\":\"${1:-$name}\",\"tools\":{\"transcript\":\"1.0.0\",\"yt-dlp\":\"2026.7.4\"}" "$2" "$3"; }
step() { msg step "\"status\":\"$1\",\"code\":$2,\"warnings\":[${3:-}],\"detail\":\"\""; }
printf '{"protocol_version":1,"type":"plan","items":[{"item":"%s","output":"%s"}]}\n' "$URL" "$out"
case "$STUB" in
other) intent "$name" https://youtu.be/other; exit 0 ;;
version) intent "$name" "$URL" 2; exit 0 ;;
escape) intent ../escape; exit 0 ;;
notools) msg intent '"name":"notools","tools":{}'; exit 0 ;;
early) step pending '"deepgram_unknown"'; exit 0 ;;
esac
intent
IFS= read -r ack || exit 3
dir=$(printf '%s\n' "$ack" | /usr/bin/sed -n 's/.*"output_dir":"\([^"]*\)".*/\1/p')
echo upload >> "$WORK/uploads.log"
printf 'Welcome.' > "$dir/raw_transcript.txt"
printf '' > "$dir/raw_sentences.txt"
printf '[]' > "$dir/raw_transcript.json"
case "$STUB" in
twice) intent ;;
garbage) echo 'Traceback (most recent call last):' ;;
mystery) step failed '"mystery"' ;;
mismatch) step unknown '"deepgram_key_rejected"' ;;
warning) step completed null '"mystery"' ;;
nostep) ;;
extra) step completed null; step completed null ;;
late) step completed null; exit 1 ;;
*) step completed null ;;
esac
-- bin/python3 --
#!/bin/sh
echo "Python 3.14.0"
-- seed.jsonl --
{"call":"set","account":"deepgram","key":"dg-test-key"}
