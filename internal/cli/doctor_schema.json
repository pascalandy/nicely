{
  "type": "object",
  "required": ["checks"],
  "properties": {
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "component", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "component": {"type": "string"},
        "status": {"enum": ["pass", "warn", "fail"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "hint": {"type": "string"},
        "next": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "domain": {"type": "string"},
        "source": {"enum": ["bundled", "extension"]},
        "path": {"type": ["string", "null"]},
        "hidden_by": {
          "type": "object",
          "required": ["source", "path"],
          "properties": {
            "source": {"enum": ["core", "bundled", "extension"]},
            "path": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
