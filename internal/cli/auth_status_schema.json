{
  "type": "object",
  "required": ["keychain", "services"],
  "properties": {
    "keychain": {"enum": ["available", "unavailable"]},
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["service", "configured", "source", "grants"],
      "properties": {
        "service": {"type": "string"},
        "configured": {"type": "boolean"},
        "source": {"enum": ["env", "keychain", "none"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "hint": {"type": "string"},
        "next": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}}
      }
    },
    "grant": {
      "type": "object",
      "required": ["domain", "granted", "optional"],
      "properties": {
        "domain": {"type": "string"},
        "granted": {"type": "boolean"},
        "optional": {"type": "boolean"}
      }
    }
  }
}
