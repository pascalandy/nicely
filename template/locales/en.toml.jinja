# English catalog of the {{ slug }} extension. Each entry needs a description
# of where the text appears, for the translator. A text between {% raw %}{{ and }}{% endraw %} is
# a field that the handler fills.

{% if not name %}["{{ slug }}.summary"]
description = "Help page: summary of the {{ domain }} domain in ncly --help."
other = "Inspect files"

{% endif %}["{{ slug }}.inspect.summary"]
description = "Help page: summary of `ncly {{ example_command }}`, which gives the size and the line count of a file."
other = "Give the size and the line count of a file"

["{{ slug }}.inspect.file"]
description = "Help page: the file argument of `ncly {{ example_command }}`."
other = "File to inspect"

["{{ slug }}.inspect.timeout"]
description = "Help page: the --timeout flag of `ncly {{ example_command }}`, which bounds the run of its worker."
other = "Stop the inspection after this duration"

["{{ slug }}.inspect.no_file"]
description = "Message of USAGE_INVALID when the file of `ncly {{ example_command }}` is missing or is no regular file. {% raw %}{{.File}}{% endraw %} is the path that the caller gave."
other = "{% raw %}{{.File}}{% endraw %} is no file that {{ root }} can inspect."

["{{ slug }}.inspect.bad_timeout"]
description = "Message of USAGE_INVALID when the --timeout of `ncly {{ example_command }}` is no positive duration. {% raw %}{{.Timeout}}{% endraw %} is the value that the caller gave, and --timeout stays as is."
other = "--timeout {% raw %}{{.Timeout}}{% endraw %} is no duration, such as 30s or 5m."

["{{ slug }}.inspect.result"]
description = "Text of `ncly {{ example_command }}`: the line count and the size of the file. {% raw %}{{.File}}{% endraw %} is the path that the caller gave, {% raw %}{{.Count}}{% endraw %} the line count, and {% raw %}{{.Size}}{% endraw %} the size with its unit, such as 12 B."
one = "{% raw %}{{.File}}{% endraw %}: {% raw %}{{.Count}}{% endraw %} line, {% raw %}{{.Size}}{% endraw %}"
other = "{% raw %}{{.File}}{% endraw %}: {% raw %}{{.Count}}{% endraw %} lines, {% raw %}{{.Size}}{% endraw %}"

["{{ slug }}.inspect.not_text"]
description = "Message of {{ slug | upper | replace("-", "_") }}_NOT_TEXT when the file of `ncly {{ example_command }}` holds a NUL byte, such as an image, so its lines mean nothing. {% raw %}{{.File}}{% endraw %} is the path that the caller gave."
other = "{% raw %}{{.File}}{% endraw %} is no text file, so its lines mean nothing."

["{{ slug }}.inspect.not_text_hint"]
description = "Hint of {{ slug | upper | replace("-", "_") }}_NOT_TEXT, which names a text file to inspect instead. {% raw %}{{.File}}{% endraw %} is the path that the caller gave."
other = "Give ncly {{ example_command }} a text file, such as notes.md, instead of {% raw %}{{.File}}{% endraw %}."
