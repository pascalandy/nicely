format_version = 1
contract_version = 1
domain = "{{ domain }}"{% if name %}
name = "{{ name }}"{% endif %}

{% if not name %}[[commands]]
path = "{{ domain }}"
summary = "{{ slug }}.summary"
examples = ["ncly {{ example_command }} notes.md", "ncly {{ example_command }} notes.md --json"]

{% endif %}[[commands]]
path = "{{ example_command }}"
summary = "{{ slug }}.inspect.summary"
examples = ["ncly {{ example_command }} notes.md", "ncly {{ example_command }} notes.md --json"]
effects = {}
requires = { bins = ["python3"] }

[[commands.args]]
name = "file"
summary = "{{ slug }}.inspect.file"
required = true

[[commands.flags]]
name = "timeout"
value = "duration"
default = "30s"
summary = "{{ slug }}.inspect.timeout"

[commands.result.schema]
type = "object"
required = ["size_bytes", "lines"]
properties = { size_bytes = { type = "integer", minimum = 0 }, lines = { type = "integer", minimum = 0 } }

[programs.python3]
version = "3.9"
install = { brew = ["brew", "install", "python"], pacman = ["sudo", "pacman", "-S", "python"], apt = ["sudo", "apt", "install", "python3"], dnf = ["sudo", "dnf", "install", "python3"] }
