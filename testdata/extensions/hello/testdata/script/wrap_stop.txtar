# hello count runs its worker count.sh with bash through sdk/wrap, as wrap.txtar shows. This
# scenario covers what stops the program: the timeout, Ctrl-C, and a version probe that does
# not finish. stub/bash stands in for bash. It answers the version probe, writes the path of
# the worker, then does what STUB says.
chmod 755 stub/bash
env PATH=$WORK/stub:$PATH
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=

# At the timeout, the whole process tree stops, a child in its own process group included,
# with exit 1, and the folder of the worker goes
env STUB=hang
exits 1 ncly hello count input.md --timeout 1s --json
answer stderr RUNTIME
stderr '"message":"bash did not finish within 1 s, so it was stopped\.'
gone hang.pid
gone child.pid
exec /bin/sh -c 'test ! -e "$(cat worker.path)"'

# Ctrl-C stops the process tree too, with exit 130, and the folder of the worker goes
rm hang.pid child.pid worker.path
exec exitcode exit.txt ncly hello count input.md --json &
waitfile hang.pid
kill -INT
wait
grep '^130$' exit.txt
! stdout .
answer stderr INTERRUPTED
gone hang.pid
gone child.pid
exec /bin/sh -c 'test ! -e "$(cat worker.path)"'

# A program that ignores Ctrl-C runs until the SIGKILL of core's cleanup, 4 seconds in the
# test binary, and the folder of the worker is gone before that SIGKILL
rm hang.pid child.pid worker.path
env STUB=stubborn
exec exitcode exit.txt ncly hello count input.md --json &
waitfile stubborn.pid
kill -INT
wait
grep '^130$' exit.txt
answer stderr INTERRUPTED
gone stubborn.pid
exec /bin/sh -c 'test ! -e "$(cat worker.path)"'

# A version probe that does not finish in time is PREREQ_MISSING with exit 78, before work
rm worker.path
env STUB=probe-hang
exits 78 ncly hello count input.md --timeout 1s --json
answer stderr PREREQ_MISSING
stderr '"message":"bash --version did not print its version in time\.","hint":"Check that bash --version prints a version and exits\."\}'
gone probe.pid
! exists worker.path

-- input.md --
One line
-- stub/bash --
#!/bin/sh
if [ "$1" = --version ]; then
  if [ "$STUB" = probe-hang ]; then
    echo $$ > "$WORK/probe.pid"
    exec /bin/sleep 30
  fi
  echo 'GNU bash, version 5.2.0(1)-release'
  exit 0
fi
echo "$1" > "$WORK/worker.path"
case "$STUB" in
hang)
  pgroup /bin/sh -c 'echo $$ > "$WORK/child.tmp"; mv "$WORK/child.tmp" "$WORK/child.pid"; exec /bin/sleep 30' >/dev/null 2>&1 &
  while [ ! -f "$WORK/child.pid" ]; do /bin/sleep 0.01; done
  echo $$ > "$WORK/hang.tmp"
  mv "$WORK/hang.tmp" "$WORK/hang.pid"
  exec /bin/sleep 30
  ;;
stubborn)
  trap '' INT TERM
  echo $$ > "$WORK/stubborn.tmp"
  mv "$WORK/stubborn.tmp" "$WORK/stubborn.pid"
  exec /bin/sleep 30
  ;;
*)
  exec /bin/bash "$@"
  ;;
esac
