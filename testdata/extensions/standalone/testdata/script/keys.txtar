# The kit gives the example service the sentinel key sentinel-example, so ncly
# passes a granted key from its variable and never reads the keychain.
# Without a grant, ncly passes no key, and the extension names the grant.
exits 78 ncly standalone fetch --json
stderr '"code":"KEY_NOT_GRANTED"'
stderr '"next":\["ncly","auth","grant","example","standalone"\]'

# Granted, the extension receives the sentinel: the digest is its SHA-256.
grant example
ncly standalone fetch --json
stdout '"sha256":"d6d31537518a7b2a474bb480861a0c57d94e64a4b3ca41f2020d3463bd9488f1"'

# Run directly, the extension answers the code that NCLY_MISSING_KEYS names,
# and no ncly runs, so nothing reads the keychain.
env NCLY_MISSING_KEYS=example=AUTH_MISSING
exits 78 ncly-standalone fetch --json
stderr '"code":"AUTH_MISSING"'
env NCLY_MISSING_KEYS=example=KEYRING_UNAVAILABLE
exits 78 ncly-standalone fetch --json
stderr '"code":"KEYRING_UNAVAILABLE"'
env NCLY_MISSING_KEYS=

# Without its sentinel, a granted key sends ncly to the keychain. On Linux,
# the kit points D-Bus at no bus, so ncly finds no keychain, not the user's.
[linux] env EXAMPLE_API_KEY=
[linux] exits 78 ncly standalone fetch --json
[linux] stderr '"code":"KEYRING_UNAVAILABLE"'
