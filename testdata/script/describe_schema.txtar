# The result of a command's detail gives its kind, its keys, and the JSON Schema of its
# answers, draft 2020-12, with every reference resolved, plus dry_run_schema when the
# command supports dry run. The fixture's real answers, collected in separate calls, fit
# the schema that their invocation selects, so a schema cannot drift from what the
# command answers. ncly-bundled is ncly with the Go fixture hello bundled.
chmod 755 bin/ncly-bare
env PATH=$WORK/bin:$PATH

# Core's describe gives its own schema, and its answers fit it, a failure included
exec ncly describe describe --json
cp stdout describe.json
stdout '"result":\{"kind":"object","keys":\["commands"\],"schema":\{"\$schema":"https://json-schema\.org/draft/2020-12/schema",'
! stdout '\$ref'
! stdout '"dry_run_schema":\{"\$schema"'
schema describe.json describe.json schema
exec ncly describe --json
schema stdout describe.json schema
exits 2 ncly describe nope --json
schema stderr describe.json schema

# A text result has empty keys and no schema
exec ncly describe completion zsh --json
stdout '"result":\{"kind":"text","keys":\[\]\}'

# An object and its failure, then a report that needs a human, fit their schema
exec ncly-bundled describe hello run --json
cp stdout run.json
stdout '"result":\{"kind":"object","keys":\["greeting"\],'
exec ncly-bundled hello run Ada --json
schema stdout run.json schema
exits 1 ncly-bundled hello run --grumpy --json
schema stderr run.json schema
exec ncly-bundled describe hello check --json
cp stdout check.json
stdout '"result":\{"kind":"report","keys":\["checks"\],'
! stdout '\$ref'
exits 78 ncly-bundled hello check --json
schema stdout check.json schema

# A command with dry run has two schemas, and each answer fits only the one that its
# invocation selects. The dry run writes nothing
exec ncly-bundled describe hello pick --json
cp stdout pick.json
stdout '"keys":\["args","flags","lists","picked"\]'
stdout '"dry_run_schema":\{"\$schema":'
! stdout '\$ref'
exec ncly-bundled hello pick Ada --mood calm --left --dry-run --json
cp stdout dry.json
schema dry.json pick.json dry_run_schema
! schema dry.json pick.json schema
! exists picked
exec ncly-bundled hello pick Ada --mood calm --left --tag a --json
schema stdout pick.json schema
! schema stdout pick.json dry_run_schema
exists picked

# A command that declares no schema gets the envelope alone, with no key
exec ncly describe bare run --json
cp stdout bare.json
stdout '"result":\{"kind":"object","keys":\[\],"schema":\{'
exec ncly bare run --json
schema stdout bare.json schema

# The envelope follows the answer check: a success may hold empty errors and warnings
# but no error, and a failure other than a report's holds at least one error
! schema okerror.json bare.json schema
! schema noerror.json bare.json schema

# A batch's schema requires an item's data only when the item succeeded, keeps the
# constraints of results, keeps literal values, such as a const that holds $defs, and
# allows no failed item in a success
exec ncly describe bare batch --json
cp stdout batch.json
stdout '"keys":\["results"\]'
stdout '"minItems":1'
exits 1 ncly bare batch --json
schema stderr batch.json schema
! schema empty.json batch.json schema
! schema baditem.json batch.json schema
schema okbatch.json batch.json schema
! schema okfailed.json batch.json schema

# A batch's dry run answers plan instead of results, so its schema needs no results
exec ncly bare batch --dry-run --json
schema stdout batch.json dry_run_schema
! schema stdout batch.json schema

# A local reference may percent-encode its pointer, as a URI fragment does
exec ncly describe bare spaced --json
stdout '"keys":\["count"\]'
stdout '"count":\{"minimum":0,"type":"integer"\}'
! stdout '\$ref'

-- empty.json --
{"ok":true,"contract_version":1,"results":[]}
-- okerror.json --
{"ok":true,"contract_version":1,"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}
-- noerror.json --
{"ok":false,"contract_version":1,"errors":[]}
-- okbatch.json --
{"ok":true,"contract_version":1,"results":[{"ok":true,"value":"a"}]}
-- okfailed.json --
{"ok":true,"contract_version":1,"results":[{"ok":false,"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}]}
-- baditem.json --
{"ok":false,"contract_version":1,"results":[{"ok":false}],"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}
-- bin/ncly-bare --
#!/bin/sh
if [ "$1" = batch ] && [ "$2" = --dry-run=true ]; then
  echo '{"ok":true,"contract_version":1,"dry_run":true,"plan":[],"pending_checks":[]}'
  exit 0
fi
if [ "$1" = batch ]; then
  echo '{"ok":false,"contract_version":1,"results":[{"ok":true,"value":"a","mark":{"$defs":"literal"}},{"ok":false,"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}],"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}' >&2
  exit 1
fi
echo '{"ok":true,"contract_version":1,"anything":[1],"errors":[],"warnings":[]}'
-- bin/ncly-bare.toml --
format_version = 1
contract_version = 1
domain = "bare"

[[commands]]
path = "bare"
summary = "bare.summary"

[[commands]]
path = "bare run"
summary = "bare.summary"

[[commands]]
path = "bare spaced"
summary = "bare.summary"

[commands.result.schema]
"$schema" = "https://json-schema.org/draft/2020-12/schema"
type = "object"
properties = { count = { "$ref" = "#/$defs/a%20count" } }
"$defs" = { "a count" = { type = "integer", minimum = 0 } }

[[commands]]
path = "bare batch"
summary = "bare.summary"
modes = { dry_run = true, recorded = true }

[commands.result]
kind = "batch"

[commands.result.schema]
type = "object"

[commands.result.schema.properties.results]
type = "array"
minItems = 1

[commands.result.schema.properties.results.items]
type = "object"
required = ["value"]
properties = { value = { type = "string" }, mark = { const = { "$defs" = "literal" } } }

[commands.result.dry_run_schema]
type = "object"
required = ["dry_run", "plan", "pending_checks"]
properties = { dry_run = { const = true }, plan = { type = "array" }, pending_checks = { type = "array" } }
-- bin/ncly-bare.locales/en.toml --
["bare.summary"]
description = "Summary of the bare fixture."
other = "Answer without a schema"
