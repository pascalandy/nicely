# ncly run view shows one saved record without taking its lock: every key that the file holds,
# then active, which it reads from the lock without creating it. A saved run that failed still
# inspects with exit 0, and a record that cannot be used answers RESUME_UNSAFE.
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=
onlyncly holdlock pty
env RUNS=$WORK/.local/state/nicely/runs
mkdir $RUNS
cp c1.json $RUNS/c1.json
cp f1.json $RUNS/f1.json
cp r1.json $RUNS/r1.json
cp garbage.json $RUNS/bad.json
cp v2.json $RUNS/v2.json

# A completed run: every key of the file, numbers as the file holds them, a key that this
# release does not know, then active. Viewing it creates no lock file
exec ncly run view c1 --json
stdout '\A\{"ok":true,"contract_version":1,"run":\{"active":false,"attempts":1,"format_version":1,"future_key":"kept",'
stdout '"inputs":\{"cwd":"/work","options":\{"lang":"fr","max":3\},"task_sha256":"87b5","tools":true,"urls":\["u1","u2"\]\}'
stdout '"artifacts":\[\{"path":"/state/runs/c1/answer\.txt","sha256":"1762","size_bytes":16\}\],"effect":"paid","error":null,"evidence":\{"duration_ms":28,"format_version":1\}'
! stderr .
! exists $RUNS/c1.lock
cp stdout view.json
exec ncly describe 'run view' --json
cp stdout describe.json
schema view.json describe.json schema
exec ncly run view c1
cmp stdout want-c1.txt
! stderr .

# On a terminal, the run ID and the headings are bold, and the labels of the facts, the inputs,
# and the resolved values are bright black. A completed run and a completed step are green,
# and the arrow, the effect, and the size of an artifact are bright black. The tools stay
# plain, and the text without its escape sequences is the text of a pipe
exec pty none.txt ncly run view c1
stdout '^\x1b\[1mc1\x1b\[m  agent run$'
stdout '^\x1b\[90mstatus\x1b\[m    \x1b\[32mcompleted\x1b\[m$'
stdout '^\x1b\[90mactive\x1b\[m    no$'
stdout '^\x1b\[90mncly\x1b\[m      v0\.10\.0$'
stdout '^\x1b\[1mINPUTS\x1b\[m$'
stdout '^  \x1b\[90mcwd\x1b\[m          /work$'
stdout '^  \x1b\[90moptions\x1b\[m$'
stdout '^    \x1b\[90mlang\x1b\[m  fr$'
stdout '^    u1$'
stdout '^  \x1b\[90meffort\x1b\[m   medium$'
stdout '^  codex  0\.163\.0$'
stdout '^  task \x1b\[90m→\x1b\[m /state/runs/c1$'
stdout '^    \x1b\[32mcompleted\x1b\[m  codex  \x1b\[90mpaid\x1b\[m  2026-10-17T18:37:13Z → 2026-10-17T18:37:14Z, 1 s$'
stdout '^      /state/runs/c1/answer\.txt  \x1b\[90m16 B\x1b\[m$'
plain stdout shown.txt
cmp shown.txt want-c1.txt

# A saved run that failed still inspects with exit 0: ok describes the inspection, and status
# the saved operation. The text shows the error of the step and its hint
exec ncly run view f1 --json
stdout '\A\{"ok":true,"contract_version":1,"run":\{"active":false,'
stdout '"status":"failed"'
exec ncly run view f1
cmp stdout want-f1.txt

# On a terminal, a failed step is red and a pending one bright black, beside the error block of
# the failed step. A failed run stays plain
exec pty none.txt ncly run view f1
stdout '^\x1b\[90mstatus\x1b\[m    failed$'
stdout '^    \x1b\[31mfailed\x1b\[m   transcribe  \x1b\[90mpaid\x1b\[m  2026-10-01T10:00:00Z → 2026-10-01T10:00:05Z, 5 s$'
stdout '^      \x1b\[1;31merror\[RUNTIME\]:\x1b\[m Deepgram refused the file\.$'
stdout '^      \x1b\[1;36mhint:\x1b\[m Check the file, then run again\.$'
stdout '^    \x1b\[90mpending\x1b\[m  summarize   \x1b\[90mnone\x1b\[m$'
plain stdout shown.txt
cmp shown.txt want-f1.txt

# While another process holds a run, view answers at once with active, and a step that
# started without an end shows its start alone
! exec holdlock $RUNS/r1.lock held &
waitfile held
exec ncly run view r1 --json
stdout '"active":true'
exec ncly run view r1
stdout '^active    yes$'
stdout '^    unknown  codex  paid  2026-10-17T18:40:00Z$'
# On a terminal, a running run and an unknown step stay plain
exec pty none.txt ncly run view r1
stdout '^\x1b\[90mstatus\x1b\[m    running$'
stdout '^\x1b\[90mactive\x1b\[m    yes$'
stdout '^    unknown  codex  \x1b\[90mpaid\x1b\[m  2026-10-17T18:40:00Z$'
kill
wait
exec ncly run view r1 --json
stdout '"active":false'

# A run ID outside the rule is USAGE_INVALID, and an unknown run NOT_FOUND, whose next lists
# the runs
exits 2 ncly run view Bad_ID --json
answer stderr USAGE_INVALID
stderr '"message":"Bad_ID is no run ID: a run ID holds 1 to 64 lowercase letters, digits, and hyphens, and starts with a letter or a digit\."'
exits 2 ncly run view nothing --json
answer stderr NOT_FOUND
stderr '"message":"No record holds the run nothing\.","hint":"ncly run list","next":\["ncly","run","list"\]'
! exists $RUNS/nothing.lock

# A record that is no JSON, or that holds another format_version, is RESUME_UNSAFE, and stays
exits 1 ncly run view bad --json
answer stderr RESUME_UNSAFE
stderr '"message":"Cannot read the record '${RUNS@R}'/bad\.json, or this release does not support its format\."'
exits 1 ncly run view v2 --json
answer stderr RESUME_UNSAFE
cmp $RUNS/v2.json v2.json

# So is a record that breaks Record format, such as one whose started_at is no time, which run
# list counts as unreadable, one that lacks keys, and one whose item lacks output_dir
cp badtime.json $RUNS/badtime.json
exits 1 ncly run view badtime --json
answer stderr RESUME_UNSAFE
cp partial.json $RUNS/partial.json
exits 1 ncly run view partial --json
answer stderr RESUME_UNSAFE
exec /bin/sh -c '/usr/bin/sed -e "s/,\"output_dir\":\"[^\"]*\"//" -e "s/\"run_id\":\"c1\"/\"run_id\":\"nodir\"/" "$RUNS/c1.json" > "$RUNS/nodir.json"'
! grep output_dir $RUNS/nodir.json
exits 1 ncly run view nodir --json
answer stderr RESUME_UNSAFE

# A run whose lock cannot be read is RESUME_UNSAFE, because its active would be a guess
exec /bin/sh -c ': > "$RUNS/c1.lock"'
chmod 000 $RUNS/c1.lock
exits 1 ncly run view c1 --json
answer stderr RESUME_UNSAFE
stderr '"message":"Cannot read the lock '${RUNS@R}'/c1\.lock, so ncly cannot tell whether a process runs c1\.","hint":"Inspect the file before you start any new run of the same work: its run may have billed\."'
chmod 600 $RUNS/c1.lock

# The text writes a count as the locale does, with its separator of thousands
cp many.json $RUNS/many.json
exec ncly run view many
stdout '^attempts  1,003$'
# On a terminal, an unknown run stays plain too
exec pty none.txt ncly run view many
stdout '^\x1b\[90mstatus\x1b\[m    unknown$'

# The text of the view comes from the catalog
exec ncly --lang en-XA run view f1
pseudo stdout f1 transcript run youtube failed pending transcribe summarize paid none u1 2026-10-01T10:00:00Z 2026-10-01T10:00:05Z v0.13.0 RUNTIME Deepgram refused the file Check then again 1 lang fr

-- want-c1.txt --
c1  agent run
status    completed
active    no
started   2026-10-17T18:37:13Z
updated   2026-10-17T18:37:14Z
attempts  1
ncly      v0.10.0

INPUTS
  cwd          /work
  options
    lang  fr
    max   3
  task_sha256  87b5
  tools        true
  urls
