{"format_version":1,"run_id":"c1","path":"agent run","status":"completed","started_at":"2026-10-17T18:37:13Z","updated_at":"2026-10-17T18:37:14Z","ncly_version":"v0.10.0","attempts":1,"inputs":{"cwd":"/work","task_sha256":"87b5","tools":true,"urls":["u1","u2"],"options":{"lang":"fr","max":3}},"resolved":{"effort":"medium","harness":"codex","model":"m1"},"tools":{"codex":"0.163.0"},"items":[{"key":"task","output_dir":"/state/runs/c1","steps":[{"id":"codex","effect":"paid","status":"completed","started_at":"2026-10-17T18:37:13Z","finished_at":"2026-10-17T18:37:14Z","artifacts":[{"path":"/state/runs/c1/answer.txt","size_bytes":16,"sha256":"1762"}],"error":null,"evidence":{"format_version":1,"duration_ms":28}}]}],"future_key":"kept"}
