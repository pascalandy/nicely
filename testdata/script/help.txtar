# Bare ncly prints the help on stdout and exits 0
exec ncly
stdout 'Curated CLI toolbox'
! stderr .
cp stdout bare.txt

# --help and ncly help print the same text
exec ncly --help
cmp stdout bare.txt
! stderr .
exec ncly help
cmp stdout bare.txt
! stderr .

# The help shows its sections, the commands, the global flags, and ends with examples
stdout '^USAGE$'
stdout '^  ncly <command> \[flags\]$'
stdout '^COMMANDS$'
stdout '^  completion: +Print shell completion scripts$'
stdout '^FLAGS$'
stdout '^      --json +Answer with one line of JSON$'
stdout '^      --lang <tag> +Language of human text'
stdout '^EXAMPLES$'
stdout '^  \$ ncly --version$'

# A subcommand lists the global flags apart from its own
exec ncly completion zsh --help
stdout '^  ncly completion zsh \[flags\]$'
stdout '^GLOBAL FLAGS$'
! stdout '^COMMANDS$'

# ncly help prints the same page for a subcommand, usage line included
cp stdout zsh-help.txt
exec ncly help completion zsh
cmp stdout zsh-help.txt
! stderr .

# Help wins over unknown flags and unknown commands, and ignores --json
exec ncly --unknown-flag --help --json
cmp stdout bare.txt
! stderr .
exec ncly nope -h
cmp stdout bare.txt
! stderr .
env NCLY_JSON=1
exec ncly --help
cmp stdout bare.txt
! stderr .
env NCLY_JSON=

# Help wins inside a group of shorthands, whatever the order and an unknown letter
exec ncly -zh
cmp stdout bare.txt
! stderr .
exec ncly -hz
cmp stdout bare.txt
exec ncly -vzh
cmp stdout bare.txt

# After --, -h is an operand, not a request for help
exits 2 ncly -- -h
! stdout .
stderr 'Unknown command "-h"'

# Under the pseudo-locale, every word of the help comes from the catalog
exec ncly --lang en-XA --help
pseudo stdout completion
exec ncly --lang en-XA completion --help
pseudo stdout completion zsh bash fish
exec ncly --lang en-XA completion zsh --help
pseudo stdout completion zsh

# The help has styles only when color is on: CLICOLOR_FORCE keeps them in a pipe,
# and an empty NO_COLOR keeps them too, as no-color.org defines
env CLICOLOR_FORCE=1
exec ncly --help
stdout '\x1b\['
exec ncly --help --no-color
! stdout '\x1b\['
env NO_COLOR=1
exec ncly --help
! stdout '\x1b\['
env NO_COLOR=
exec ncly --help
stdout '\x1b\['
env TERM=dumb
exec ncly --help
! stdout '\x1b\['

# The usage line keeps the positional arguments of a command
exec ncly help help
stdout '^  ncly help \[command\] \[flags\]$'
