# Bare ncly prints the help on stdout and exits 0
exec ncly
stdout '(?i)usage'
! stderr .
cp stdout bare.txt

# --help and ncly help print the same text
exec ncly --help
cmp stdout bare.txt
! stderr .
exec ncly help
cmp stdout bare.txt
! stderr .

# The help lists the global flags with their descriptions
stdout '--json +Answer with one line of JSON'
stdout '--no-input +Never prompt, even in a terminal'

# Help wins over unknown flags and unknown commands, and ignores --json
exec ncly --unknown-flag --help --json
cmp stdout bare.txt
! stderr .
exec ncly nope -h
cmp stdout bare.txt
! stderr .
env NCLY_JSON=1
exec ncly --help
cmp stdout bare.txt
! stderr .
env NCLY_JSON=

# Help wins inside a group of shorthands, whatever the order and an unknown letter
exec ncly -zh
cmp stdout bare.txt
! stderr .
exec ncly -hz
cmp stdout bare.txt
exec ncly -vzh
cmp stdout bare.txt

# After --, -h is an operand, not a request for help
exits 2 ncly -- -h
! stdout .
stderr 'Unknown command "-h"'
