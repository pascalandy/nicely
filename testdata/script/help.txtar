# Bare ncly prints the help on stdout and exits 0
exec ncly
stdout 'Curated CLI toolbox'
! stderr .
cp stdout bare.txt

# --help and ncly help print the same text
exec ncly --help
cmp stdout bare.txt
! stderr .
exec ncly help
cmp stdout bare.txt
! stderr .

# The help shows its sections, the commands, the global flags, and ends with examples
stdout '^USAGE$'
stdout '^  ncly <command> \[flags\]$'
stdout '^COMMANDS$'
stdout '^  completion: +Print shell completion scripts$'
stdout '^FLAGS$'
stdout '^      --json +Answer with one line of JSON$'
stdout '^      --lang <tag> +Language of human text'
stdout '^EXAMPLES$'
stdout '^  \$ ncly --version$'

# A subcommand lists the global flags apart from its own
exec ncly completion zsh --help
stdout '^  ncly completion zsh \[flags\]$'
stdout '^GLOBAL FLAGS$'
! stdout '^COMMANDS$'

# ncly help prints the same page for a subcommand, usage line included
cp stdout zsh-help.txt
exec ncly help completion zsh
cmp stdout zsh-help.txt
! stderr .

# Help wins over unknown flags and unknown commands, and ignores --json
exec ncly --unknown-flag --help --json
cmp stdout bare.txt
! stderr .
exec ncly nope -h
cmp stdout bare.txt
! stderr .
env NCLY_JSON=1
exec ncly --help
cmp stdout bare.txt
! stderr .
env NCLY_JSON=

# Help wins inside a group of shorthands, whatever the order and an unknown letter
exec ncly -zh
cmp stdout bare.txt
! stderr .
exec ncly -hz
cmp stdout bare.txt
exec ncly -vzh
cmp stdout bare.txt

# After --, -h is an operand, not a request for help
exits 2 ncly -- -h
! stdout .
stderr 'Unknown command "-h"'

# Under the pseudo-locale, every word of the help comes from the catalog
exec ncly --lang en-XA --help
pseudo stdout completion describe
exec ncly --lang en-XA completion --help
pseudo stdout completion zsh bash fish
exec ncly --lang en-XA completion zsh --help
pseudo stdout completion zsh

# The help has styles only when color is on: CLICOLOR_FORCE keeps them in a pipe,
# and an empty NO_COLOR keeps them too, as no-color.org defines
env CLICOLOR_FORCE=1
exec ncly --help
stdout '\x1b\['
exec ncly --help --no-color
! stdout '\x1b\['
env NO_COLOR=1
exec ncly --help
! stdout '\x1b\['
env NO_COLOR=
exec ncly --help
stdout '\x1b\['
env TERM=dumb
exec ncly --help
! stdout '\x1b\['

# --no-color=false wins over NO_COLOR and TERM=dumb, as each flag wins over its variable
env NO_COLOR=1
exec ncly --help --no-color=false
stdout '\x1b\['
env NO_COLOR= TERM=

# The usage line keeps the positional arguments of a command
exec ncly help help
stdout '^  ncly help \[command\] \[flags\]$'

# A command's help shows its arguments, its required flags, its flag groups, and one line
# of effects from the declaration that ncly describe returns, so help and discovery never
# disagree. A required argument is <name>, an optional one [name], a group that needs a
# flag (--a | --b), and one that does not [--a | --b]
env CLICOLOR_FORCE=
chmod 755 bin/ncly-shop
env PATH=$WORK/bin:$PATH
exec ncly describe --help
cp stdout page.txt
stdout '^  ncly describe \[command\.\.\.\] \[flags\]$'
! stdout 'Effects'
exec ncly describe describe --json
agree page.txt stdout

exec ncly shop buy --help
cp stdout page.txt
stdout '^  ncly shop buy <item> \[quantity\] --store <name> \(--cash \| --card\) \[--email \| --sms\] \(--bag \| --box\) \[flags\]$'
stdout '^Effects: changes your files, uses the network\. Preview them with --dry-run\.$'
stdout '^  -n, --dry-run +Show the planned effects'
stdout '^      --run-id <id> +Name the run'
exec ncly describe shop buy --json
agree page.txt stdout

# A command that declares no effects may have every one, and a group names none
exec ncly shop list --help
cp stdout page.txt
stdout '^Effects: changes your files, uses the network, may bill\.$'
exec ncly describe shop list --json
agree page.txt stdout
exec ncly shop --help
! stdout 'Effects'

# The bundled Go fixture's help agrees with its describe answer too
exec ncly-bundled hello pick --help
cp stdout page.txt
stdout '^  ncly hello pick <name> --mood <word> \(--left \| --right\) \[flags\]$'
stdout '^Effects: changes your files\. Preview them with --dry-run\.$'
exec ncly-bundled describe hello pick --json
agree page.txt stdout

# A command with arguments and children runs, so its usage line is its own, not a group's
chmod 755 bin/ncly-probe
exec ncly probe run --help
cp stdout page.txt
stdout '^  ncly probe run <target> --mode <name> \[flags\]$'
stdout '^  fast: +Probe fast$'
exec ncly describe probe run --json
agree page.txt stdout

# Under the pseudo-locale, every word of the page comes from a catalog, and the page still agrees
exec ncly --lang en-XA shop buy --help
cp stdout page.txt
pseudo stdout shop buy
exec ncly --lang en-XA describe shop buy --json
agree page.txt stdout
! exists ran

-- bin/ncly-shop --
#!/bin/sh
echo "shop $*" >> "$WORK/ran"
echo '{"ok":true,"contract_version":1}'
-- bin/ncly-shop.toml --
format_version = 1
contract_version = 1
domain = "shop"

[[commands]]
path = "shop"
summary = "shop.summary"

[[commands]]
path = "shop list"
summary = "shop.list.summary"
examples = ["ncly shop list", "ncly shop list --json"]

[[commands]]
path = "shop buy"
summary = "shop.buy.summary"
examples = ["ncly shop buy apple --store north --cash --bag", "ncly shop buy apple 3 --store north --card --box --json"]
effects = { user_writes = true, network = true }
modes = { dry_run = true, recorded = true }
requires = { bins = ["curl"], keys = ["shopapi"] }

[[commands.args]]
name = "item"
summary = "shop.buy.item"
required = true

[[commands.args]]
name = "quantity"
summary = "shop.buy.quantity"
type = "integer"

[[commands.flags]]
name = "store"
shorthand = "s"
value = "name"
required = true
summary = "shop.buy.store"

[[commands.flags]]
name = "budget"
value = "amount"
type = "number"
default = 10.5
summary = "shop.buy.budget"

[[commands.flags]]
name = "note"
value = "text"
variadic = true
summary = "shop.buy.note"

[[commands.flags]]
name = "cash"
summary = "shop.buy.cash"

[[commands.flags]]
name = "card"
summary = "shop.buy.card"

[[commands.flags]]
name = "email"
summary = "shop.buy.email"

[[commands.flags]]
name = "sms"
summary = "shop.buy.sms"

[[commands.flags]]
name = "bag"
summary = "shop.buy.bag"

[[commands.flags]]
name = "box"
summary = "shop.buy.box"

[[commands.flag_groups]]
flags = ["cash", "card"]
min = 1
max = 1

[[commands.flag_groups]]
flags = ["email", "sms"]
max = 1

[[commands.flag_groups]]
flags = ["bag", "box"]
min = 1

[programs.curl]
-- bin/ncly-shop.locales/en.toml --
["shop.summary"]
description = "Summary of the shop fixture."
other = "Buy things"

["shop.list.summary"]
description = "Summary of shop list."
other = "List the stores"

["shop.buy.summary"]
description = "Summary of shop buy."
other = "Buy an item"

["shop.buy.item"]
description = "The item argument of shop buy."
other = "Item to buy"

["shop.buy.quantity"]
description = "The quantity argument of shop buy."
other = "How many to buy"

["shop.buy.store"]
description = "The --store flag of shop buy."
other = "Store to buy from"

["shop.buy.budget"]
description = "The --budget flag of shop buy."
other = "Most to spend"

["shop.buy.note"]
description = "The --note flag of shop buy."
other = "Note for the store, once per flag"

["shop.buy.cash"]
description = "The --cash flag of shop buy."
other = "Pay cash"

["shop.buy.card"]
description = "The --card flag of shop buy."
other = "Pay by card"

["shop.buy.email"]
description = "The --email flag of shop buy."
other = "Send the receipt by email"

["shop.buy.sms"]
description = "The --sms flag of shop buy."
other = "Send the receipt by text message"

["shop.buy.bag"]
description = "The --bag flag of shop buy."
other = "Pack in a bag"

["shop.buy.box"]
description = "The --box flag of shop buy."
other = "Pack in a box"
-- bin/ncly-probe --
#!/bin/sh
echo "probe $*" >> "$WORK/ran"
-- bin/ncly-probe.toml --
format_version = 1
contract_version = 1
domain = "probe"

[[commands]]
path = "probe"
summary = "probe.summary"

[[commands]]
path = "probe run"
summary = "probe.summary"
examples = ["ncly probe run host-a --mode quick", "ncly probe run fast"]
effects = {}

[[commands.args]]
name = "target"
summary = "probe.summary"
required = true

[[commands.flags]]
name = "mode"
value = "name"
required = true
summary = "probe.summary"

[[commands]]
path = "probe run fast"
summary = "probe.fast"
-- bin/ncly-probe.locales/en.toml --
["probe.summary"]
description = "Summary of the probe fixture."
other = "Probe a host"

["probe.fast"]
description = "Summary of probe run fast."
other = "Probe fast"
