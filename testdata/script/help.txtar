# Bare ncly prints the help on stdout and exits 0
exec ncly
stdout 'Curated CLI toolbox'
! stderr .
cp stdout bare.txt

# --help and ncly help print the same text
exec ncly --help
cmp stdout bare.txt
! stderr .
exec ncly help
cmp stdout bare.txt
! stderr .

# The help shows its sections, the global flags, and ends with examples
stdout '^USAGE$'
stdout '^  ncly \[flags\]$'
stdout '^FLAGS$'
stdout '^      --json +Answer with one line of JSON$'
stdout '^      --lang <tag> +Language of human text'
stdout '^EXAMPLES$'
stdout '^  \$ ncly --version$'

# Help wins over unknown flags and unknown commands, and ignores --json
exec ncly --unknown-flag --help --json
cmp stdout bare.txt
! stderr .
exec ncly nope -h
cmp stdout bare.txt
! stderr .
env NCLY_JSON=1
exec ncly --help
cmp stdout bare.txt
! stderr .
env NCLY_JSON=

# Help wins inside a group of shorthands, whatever the order and an unknown letter
exec ncly -zh
cmp stdout bare.txt
! stderr .
exec ncly -hz
cmp stdout bare.txt
exec ncly -vzh
cmp stdout bare.txt

# After --, -h is an operand, not a request for help
exits 2 ncly -- -h
! stdout .
stderr 'Unknown command "-h"'

# Under the pseudo-locale, every word of the help comes from the catalog
exec ncly --lang en-XA --help
pseudo stdout

# The help has styles only when color is on: CLICOLOR_FORCE keeps them in a pipe
env CLICOLOR_FORCE=1
exec ncly --help
stdout '\x1b\['
exec ncly --help --no-color
! stdout '\x1b\['
env NO_COLOR=1
exec ncly --help
! stdout '\x1b\['
env NO_COLOR=
env TERM=dumb
exec ncly --help
! stdout '\x1b\['

# The usage line keeps the positional arguments of a command
exec ncly help help
stdout '^  ncly help \[command\] \[flags\]$'
