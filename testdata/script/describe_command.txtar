# A command path gives that command's declaration: args, flags, flag_groups, result,
# effects, requires, modes, config, and examples, from core's declarations and from the
# manifests alone.
# The shell fixture appends its call to $WORK/ran when it runs, and never may.
chmod 755 bin/ncly-shop
env PATH=$WORK/bin:$PATH
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=

# A core command declares its variadic argument and no effect
exec ncly describe describe --json
cmp stdout want-describe.json

# An external command gives every field of its manifest, with --dry-run and --run-id after
# its own flags because its modes set dry_run and recorded, and each program and service
# as an object with its name
exec ncly describe shop buy --json
cmp stdout want-buy.json

# A command that declares no effects may have every effect
exec ncly describe shop list --json
cmp stdout want-list.json

# A bundled command gives the same fields from its embedded manifest
exec ncly-bundled describe hello pick --json
cmp stdout want-pick.json

# A group still lists concise entries, and the path as one word gives the same detail
exec ncly describe shop --json
stdout -count=3 '"path":'
! stdout '"args"'
exec ncly describe 'shop buy' --json
cmp stdout want-buy.json

# Without --json, the detail prints the command's line, and its text comes from the catalogs
exec ncly describe shop buy
cmp stdout want-buy.txt
exec ncly --lang en-XA describe shop buy
pseudo stdout shop buy
exec ncly --lang en-XA describe shop buy --json
stdout '"summary":"⟦'
! stdout '"summary":"[A-Z]'

! exists ran

-- want-buy.txt --
shop buy  Buy an item
-- want-describe.json --
