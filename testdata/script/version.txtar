# The version goes to stdout, alone, and nothing goes to stderr
exec ncly --version
stdout '\Ancly v\d+\.\d+\.\d+\S*\n\z'
! stderr .

# --version is global: it works before or after a command, and ignores --json
exits 0 ncly --version --json
stdout '\Ancly v\S+\n\z'
! stderr .
exec ncly --version help
stdout '\Ancly v\S+\n\z'
! stderr .
exec ncly help --version
stdout '\Ancly v\S+\n\z'
! stderr .
exec ncly help --version --json
stdout '\Ancly v\S+\n\z'
! stderr .

# --help still wins over --version
exec ncly --version --help
stdout 'Curated CLI toolbox'
