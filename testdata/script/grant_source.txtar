-- cellar/1.0/ncly-brew --
#!/bin/sh
# Version 1.0 of brew: writes its version, then the names of the key variables that it receives,
# each with the SHA-256 of its value, then NCLY_MISSING_KEYS, to $WORK/bin-brew.log.
log="$WORK/bin-brew.log"
digest() {
	if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1
}
echo "VERSION 1.0" >"$log"
for name in $(env | sed -n 's/^\([A-Z0-9_]*_API_KEY\)=.*/\1/p' | sort); do
	eval "value=\${$name}"
	printf '%s %s\n' "$name" "$(printf '%s' "$value" | digest)" >>"$log"
done
if [ "${NCLY_MISSING_KEYS+set}" = set ]; then
	echo "NCLY_MISSING_KEYS=$NCLY_MISSING_KEYS" >>"$log"
else
	echo "NCLY_MISSING_KEYS unset" >>"$log"
fi
echo '{"ok":true,"contract_version":1}'
-- cellar/1.0/ncly-brew.toml --
format_version = 1
contract_version = 1
domain = "brew"

[[commands]]
path = "brew"
summary = "brew.summary"

[[commands]]
path = "brew run"
summary = "brew.summary"
requires = { keys = ["deepgram"] }
