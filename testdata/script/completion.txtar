# Each shell gets its script on stdout, and nothing goes to stderr
exec ncly completion zsh
stdout '^#compdef ncly'
! stderr .
exec ncly completion bash
stdout '__start_ncly'
! stderr .
exec ncly completion fish
stdout 'complete -c ncly'
! stderr .

# --version after a shell prints the version alone, not a script
exec ncly completion zsh --version
stdout '\Ancly v\S+\n\z'
! stderr .

# A completion script is text, so --json changes nothing
exec ncly completion zsh --json
stdout '^#compdef ncly'
! stderr .

# bash loads the script and registers the completion
exec bash -c 'source <(ncly completion bash) && complete -p ncly'
stdout 'ncly'

# The script asks ncly for values, and ncly lists its commands with their descriptions
exec ncly __complete ''
stdout '^completion\tPrint shell completion scripts$'
exec ncly __complete completion ''
stdout '^zsh\tPrint the completion script for zsh$'
stdout '^bash\t'
stdout '^fish\t'

# Without a shell, ncly completion prints its help and exits 0
exec ncly completion
stdout 'zsh'
stdout 'bash'
stdout 'fish'
! stderr .

# An unknown shell or an extra word is a usage error that points to the right help
exits 2 ncly completion tcsh --json
answer stderr USAGE_INVALID
stderr '"hint":"ncly completion --help","next":\["ncly","completion","--help"\]'
exits 2 ncly completion zsh extra --json
answer stderr USAGE_INVALID
stderr '"message":"Unexpected argument \\"extra\\"."'
stderr '"hint":"ncly completion zsh --help","next":\["ncly","completion","zsh","--help"\]'
exits 2 ncly help completion tcsh --json
answer stderr USAGE_INVALID

# A broken config never blocks a completion script
env NCLY_CONFIG=$WORK/broken.toml
exec ncly completion zsh
stdout '^#compdef ncly'

# Under the pseudo-locale, the descriptions that completion shows are translated
env NCLY_CONFIG=
exec ncly --lang en-XA __complete ''
stdout '^completion\t⟦'
pseudo stdout auth completion describe doctor help run skill

# Completing after --help, -h, or --version answers in the completion protocol, never with help
exec ncly __complete --help ''
stdout '^completion\t'
stdout '^:4\n\z'
! stdout 'USAGE'
exec ncly __complete -h ''
stdout '^completion\t'
! stdout 'USAGE'
exec ncly __complete completion --help ''
stdout '^zsh\t'
stdout '^:4\n\z'
exec ncly __complete --version ''
stdout '^completion\t'
! stdout '^ncly v'

# A request after global flags, as an alias such as ncly='ncly --no-input' sends it, keeps the protocol
exec ncly --no-input __complete --help ''
stdout '^completion\t'
stdout '^:4\n\z'
! stdout 'USAGE'
exec ncly --no-color __completeNoDesc --version ''
stdout '^completion$'
stdout '^:4\n\z'
! stdout '^ncly v'
exec ncly --lang en __complete -h ''
stdout '^completion\t'
! stdout 'USAGE'

# After --, __complete is an operand, never a completion request
exits 2 ncly --json -- __complete ''
answer stderr USAGE_INVALID

# A command that takes no more words offers no file names
exec ncly __complete completion zsh ''
stdout '\A:4\n\z'
exec ncly __complete completion bash ''
stdout '\A:4\n\z'
exec ncly __complete completion fish ''
stdout '\A:4\n\z'

# A language tag is never a file name, before or after a command
exec ncly __complete --lang ''
stdout '\A:4\n\z'
exec ncly __complete completion zsh --lang ''
stdout '\A:4\n\z'

# ncly help completes command names, not file names
exec ncly __complete help ''
stdout '^completion\t'
stdout '^:4\n\z'
exec ncly __complete help completion ''
stdout '^zsh\t'
stdout '^:4\n\z'

# Tab in bash offers commands after --help, without an error, and no file after a shell
[bash-completion] exec bash -c 'source tab.sh && tab ncly --help ""'
[bash-completion] ! stderr .
[bash-completion] stdout '^completion$'
[bash-completion] ! stdout 'USAGE'
[bash-completion] exec bash -c 'source tab.sh && tab ncly completion z'
[bash-completion] stdout '^zsh$'
[bash-completion] ! stderr .

# Tab through an alias that adds a global flag still offers commands after --help
[bash-completion] exec bash -c 'source tab.sh && shopt -s expand_aliases && alias ncly="ncly --no-input" && tab ncly --help ""'
[bash-completion] ! stderr .
[bash-completion] stdout '^completion$'
[bash-completion] ! stdout 'USAGE'

# A value that only an extension knows completes from the list command that values_from
# names, which core dispatches itself. The fixtures append each call to $WORK/ran
chmod 755 bin/ncly-shop
chmod 755 bin/ncly-bonus
env PATH=$WORK/bin:$PATH

# An argument and a flag that takes a value complete from their values_from, with the values
# that match the typed prefix
exec ncly __complete shop buy ap
stdout '^apple$'
stdout '^apricot$'
! stdout banana
stdout '^:4$'
exec ncly __complete shop buy --store ''
stdout '^north$'
stdout '^south$'
exec ncly __complete shop buy --store n
stdout '^north$'
! stdout south
grep '^shop item list --$' ran

# A values_from may name the list command of a second fixture. One whose foreign list
# command is not installed or does not qualify suggests nothing
exec ncly __complete bonus get --from b
stdout '\Abanana\n:4\n\z'
exec ncly __complete bonus get --ghost ''
stdout '\A:4\n\z'
exec ncly __complete bonus get --show ''
stdout '\A:4\n\z'
! grep 'item show' ran

# values_from never restricts: values that the list does not hold reach the handler
exec ncly shop buy kiwi --store west --json
stdout '"args":"buy --store=west -- kiwi"'

# A list command that fails, answers without the key, or gives an object without the field
# suggests nothing and prints nothing
env SHOP_MODE=fail
exec ncly __complete shop buy ''
stdout '\A:4\n\z'
env SHOP_MODE=nokey
exec ncly __complete shop buy ''
stdout '\A:4\n\z'
env SHOP_MODE=nofield
exec ncly __complete shop buy ''
stdout '\A:4\n\z'

# A list command that outlasts the 2 seconds gets SIGKILL, never SIGTERM, with its
# descendants, and suggests nothing. The debug log of Cobra names the timeout as the reason
env SHOP_MODE=slow
env BASH_COMP_DEBUG_FILE=$WORK/debug.log
exec ncly __complete shop buy ''
stdout '\A:4\n\z'
! exists got-term
grep 'timeout' debug.log
gone slow.pid
gone slowchild.pid
env BASH_COMP_DEBUG_FILE=

# SIGTERM during completion ends the list command and its descendants at once, without
# cleanup, and completion ends with 143
rm slow.pid slowchild.pid
exec exitcode exit.txt ncly __complete shop buy '' &
waitfile slow.pid
term
wait
grep '^143$' exit.txt
gone slow.pid
gone slowchild.pid
! exists got-term

# The list command gets the global flags that the call resolved, with NCLY_JSON=1, and no
# key of a service
env SHOP_MODE=env
env SHOP_API_KEY=sk-never-passed
exec ncly --no-input --no-color -v __complete shop buy ''
stdout '^apple$'
grep '^NCLY_JSON=1$' list-env.txt
grep '^NCLY_NO_INPUT=1$' list-env.txt
grep '^NCLY_VERBOSE=1$' list-env.txt
grep '^NO_COLOR=1$' list-env.txt
! grep sk-never-passed list-env.txt
env SHOP_API_KEY=

# A list command whose descendant keeps stdout open still ends completion within the 2
# seconds, though it answers after one second, and its descendant ends too
env SHOP_MODE=holder
exec bash -c 'TIMEFORMAT=%R; { time ncly __complete shop buy "" > holder.out 2>/dev/null; } 2> elapsed.txt'
exec awk '$1 >= 2.6 { print "took " $1 " seconds"; exit 1 }' elapsed.txt
grep '^apple$' holder.out
gone holder.pid

# The service of auth login and auth logout completes from the services that the manifests
# declare, as auth status lists them, without asking the keychain or starting an extension.
# The services of an invalid manifest never appear
chmod 755 bin/ncly-keys
chmod 755 bin/ncly-broken
exec ncly __complete auth login ''
stdout '\Adeepgram\ndropbox\nopenai\n:4\n\z'
exec ncly __complete auth login d
stdout '\Adeepgram\ndropbox\n:4\n\z'
exec ncly __complete auth logout o
stdout '\Aopenai\n:4\n\z'
exec ncly __complete auth logout deepgram ''
stdout '\A:4\n\z'
! stdout zoom

# After grant and revoke, the service completes the same way. After grant, the domain completes
# from the extensions that declare that service, and after revoke, from the grants that the
# grants file holds for it, even for a domain that no installed extension has anymore. A typed
# prefix narrows both, and no extension starts
chmod 755 bin/ncly-kiosk
exec ncly __complete auth grant ''
stdout '\Adeepgram\ndropbox\nopenai\n:4\n\z'
exec ncly __complete auth grant d
stdout '\Adeepgram\ndropbox\n:4\n\z'
exec ncly __complete auth grant deepgram ''
stdout '\Akeys\nkiosk\n:4\n\z'
exec ncly __complete auth grant deepgram ki
stdout '\Akiosk\n:4\n\z'
exec ncly __complete auth grant dropbox ''
stdout '\Akeys\n:4\n\z'
exec ncly __complete auth grant zoom ''
stdout '\A:4\n\z'
exec ncly __complete auth grant deepgram keys ''
stdout '\A:4\n\z'
exec ncly __complete auth revoke o
stdout '\Aopenai\n:4\n\z'
exec ncly __complete auth revoke deepgram ''
stdout '\Agone\nkeys\n:4\n\z'
exec ncly __complete auth revoke deepgram g
stdout '\Agone\n:4\n\z'
exec ncly __complete auth revoke dropbox ''
stdout '\A:4\n\z'
! exists test-keychain.jsonl
! grep 'keys|broken|kiosk' ran

-- bin/ncly-keys --
#!/bin/sh
echo "keys $*" >> "$WORK/ran"
-- bin/ncly-keys.toml --
format_version = 1
contract_version = 1
domain = "keys"

[[commands]]
path = "keys"
summary = "keys.summary"

[[commands]]
path = "keys pull"
summary = "keys.summary"
requires = { keys = ["openai", "deepgram"] }

[[commands]]
path = "keys push"
summary = "keys.summary"
requires = { keys = ["dropbox", "deepgram"] }
-- bin/ncly-keys.locales/en.toml --
["keys.summary"]
description = "Summary of the keys fixture."
other = "Use some keys"
-- bin/ncly-kiosk --
