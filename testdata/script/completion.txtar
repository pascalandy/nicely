[[commands]]
path = "kiosk"
summary = "kiosk.summary"
requires = { keys = ["deepgram"] }
-- bin/ncly-kiosk.locales/en.toml --
["kiosk.summary"]
description = "Summary of the kiosk fixture."
other = "Sell things"
-- .local/state/nicely/grants.json --
{"format_version":1,"grants":[{"service":"deepgram","domain":"keys","path":"/Users/me/bin/ncly-keys","granted_at":"2026-10-17T04:00:00Z"},{"service":"deepgram","domain":"gone","path":"/Users/me/bin/ncly-gone","granted_at":"2026-10-17T04:00:00Z"},{"service":"openai","domain":"keys","path":"/Users/me/bin/ncly-keys","granted_at":"2026-10-17T04:00:00Z"}]}
-- bin/ncly-broken --
#!/bin/sh
echo "broken $*" >> "$WORK/ran"
-- bin/ncly-broken.toml --
format_version = 1
contract_version = 1
domain = "other"

[[commands]]
path = "other"
summary = "other.summary"
requires = { keys = ["zoom"] }
-- bin/ncly-broken.locales/en.toml --
["other.summary"]
description = "Summary of the broken fixture."
other = "Break things"
-- broken.toml --
lang =
-- tab.sh --
# tab <words...> completes the last word as Tab does in bash, and prints the candidates.
for f in /usr/share/bash-completion/bash_completion /opt/homebrew/share/bash-completion/bash_completion; do
  [[ -r $f ]] && source "$f" && break
done
source <(ncly completion bash)
# compopt works only inside a completion that readline started, which a script cannot start.
compopt() { :; }
tab() {
  COMP_WORDS=("$@"); COMP_CWORD=$(( $# - 1 ))
  COMP_LINE="$*"; COMP_POINT=${#COMP_LINE}
  COMPREPLY=()
  __start_ncly ncly "${COMP_WORDS[COMP_CWORD]}" "${COMP_WORDS[COMP_CWORD-1]}"
  printf '%s\n' "${COMPREPLY[@]}"
}
-- bin/ncly-shop --
#!/bin/sh
echo "shop $*" >> "$WORK/ran"
case "$1 $2" in
"item list")
  case "$SHOP_MODE" in
  fail) echo '{"ok":false,"contract_version":1,"errors":[{"code":"RUNTIME","message":"m","hint":"h"}]}' >&2; exit 1 ;;
  nokey) echo '{"ok":true,"contract_version":1,"other":[]}' ;;
  nofield) echo '{"ok":true,"contract_version":1,"items":[{"name":"apple"},{"label":"pear"}]}' ;;
  slow)
    trap 'echo term > "$WORK/got-term"' TERM
    sleep 30 &
    echo $! > "$WORK/slowchild.pid"
    echo $$ > "$WORK/slow.pid"
    wait ;;
  env)
    env > "$WORK/list-env.txt"
    echo '{"ok":true,"contract_version":1,"items":[{"name":"apple"}]}' ;;
  holder)
    sleep 1
    sh -c 'echo $$ > "$WORK/holder.pid"; exec sleep 10' &
    echo '{"ok":true,"contract_version":1,"items":[{"name":"apple"}]}' ;;
  *) echo '{"ok":true,"contract_version":1,"items":[{"name":"apple"},{"name":"apricot"},{"name":"banana"}]}' ;;
  esac ;;
"store list") echo '{"ok":true,"contract_version":1,"stores":[{"id":"north"},{"id":"south"}]}' ;;
"buy "*) printf '{"ok":true,"contract_version":1,"args":"%s"}\n' "$*" ;;
esac
-- bin/ncly-shop.toml --
format_version = 1
contract_version = 1
domain = "shop"

[[commands]]
path = "shop"
summary = "shop.summary"

[[commands]]
path = "shop buy"
summary = "shop.summary"

[[commands.args]]
name = "item"
summary = "shop.summary"
values_from = { command = "shop item list", key = "items", field = "name" }

[[commands.flags]]
name = "store"
value = "id"
summary = "shop.summary"
values_from = { command = "shop store list", key = "stores", field = "id" }

[[commands]]
path = "shop item"
summary = "shop.summary"

[[commands]]
path = "shop item list"
summary = "shop.summary"
effects = { network = true }

[[commands]]
path = "shop item show"
summary = "shop.summary"
effects = {}

[[commands]]
path = "shop store"
summary = "shop.summary"

[[commands]]
path = "shop store list"
summary = "shop.summary"
effects = {}
-- bin/ncly-shop.locales/en.toml --
["shop.summary"]
description = "Summary of the shop fixture."
other = "Buy things"
