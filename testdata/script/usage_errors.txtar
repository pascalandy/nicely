# An unknown command fails as one JSON line on stderr
exits 2 ncly nope --json
! stdout .
answer stderr USAGE_INVALID
stderr '"message":"Unknown command \\"nope\\"."'
stderr '"hint":"ncly --help","next":\["ncly","--help"\]'

# A command close to an unknown word is suggested, and next opens its help
exits 2 ncly descrbe --json
! stdout .
answer stderr USAGE_INVALID
stderr '"message":"Unknown command \\"descrbe\\". Did you mean \\"describe\\"\?","hint":"ncly describe --help","next":\["ncly","describe","--help"\]'
exits 2 ncly docter
stderr '^error\[USAGE_INVALID\]: Unknown command "docter"\. Did you mean "doctor"\?$'
stderr '^  hint: ncly doctor --help$'
exits 2 ncly --lang en-XA docter
pseudo stderr docter doctor

# Under a group, the suggestion is a command of that group
exits 2 ncly run veiw --json
answer stderr USAGE_INVALID
stderr '"message":"Unknown command \\"veiw\\". Did you mean \\"view\\"\?","hint":"ncly run view --help","next":\["ncly","run","view","--help"\]'

# A bundled extension is a candidate, and a word that starts a name or lies two edits from it gets it, so tcsh gets bash
exits 2 ncly skil --json
stderr 'Did you mean \\"skill\\"\?","hint":"ncly skill --help"'
exits 2 ncly comp --json
stderr 'Did you mean \\"completion\\"\?'
exits 2 ncly completion tcsh --json
stderr 'Did you mean \\"bash\\"\?","hint":"ncly completion bash --help"'

# Without a close command, or for an operand that names a command, the hint opens the parent's help
exits 2 ncly zzzz --json
stderr '"message":"Unknown command \\"zzzz\\".","hint":"ncly --help","next":\["ncly","--help"\]'
exits 2 ncly --json -- doctor
stderr '"message":"Unknown command \\"doctor\\".","hint":"ncly --help"'

# --json works before the bad argument too
exits 2 ncly --json nope
! stdout .
answer stderr USAGE_INVALID

# NCLY_JSON=1 selects machine output, and --json=false wins over it
env NCLY_JSON=1
exits 2 ncly nope
! stdout .
answer stderr USAGE_INVALID
exits 2 ncly nope --json=false
! stderr '"ok"'
env NCLY_JSON=

# An unknown flag keeps machine output when --json follows it
exits 2 ncly --unknown-flag --json
! stdout .
answer stderr USAGE_INVALID
stderr '--unknown-flag'
stderr '"hint":"ncly --help","next":\["ncly","--help"\]'

# An unknown shorthand names its letter
exits 2 ncly -z --json
answer stderr USAGE_INVALID
stderr '"message":"Unknown flag -z."'

# An unknown shorthand's inline value is never another shorthand
exits 2 ncly -z=h --json
! stdout .
answer stderr USAGE_INVALID
stderr '"message":"Unknown flag -z."'

# A missing flag value uses the same envelope
exits 2 ncly --json --lang
! stdout .
answer stderr USAGE_INVALID
stderr '--lang'

# An invalid flag value uses the same envelope
exits 2 ncly --json --verbose=maybe
! stdout .
answer stderr USAGE_INVALID
stderr 'maybe'

# A flag that takes a value takes --json as that value, so machine mode stays off
exits 2 ncly --lang --json nope
! stdout .
! stderr '"ok"'
stderr 'Unknown command "nope"'

# A reserved name never reaches the extension registry
exits 2 ncly tap --json
answer stderr USAGE_INVALID
stderr 'tap'

# An unknown help topic is a usage error too
exits 2 ncly help nope --json
! stdout .
answer stderr USAGE_INVALID

# Words after -- are operands, and an unknown or reserved one is still a usage error
exits 2 ncly --json -- nope
! stdout .
answer stderr USAGE_INVALID
exits 2 ncly --json -- doctor
! stdout .
answer stderr USAGE_INVALID
exits 2 ncly --json -- --help
! stdout .
answer stderr USAGE_INVALID
stderr 'Unknown command \\"--help\\"'
env NCLY_JSON=1
exits 2 ncly -- nope
! stdout .
answer stderr USAGE_INVALID
env NCLY_JSON=

# The last valid --json wins, and an invalid one never cancels machine mode
exits 2 ncly --json --json=bad
! stdout .
answer stderr USAGE_INVALID
exits 2 ncly --json=bad --json
! stdout .
answer stderr USAGE_INVALID
exits 2 ncly --json --json=false nope
! stdout .
! stderr '"ok"'

# After --, a built-in name is an operand too, never a command
exits 2 ncly --json -- help nope
! stdout .
answer stderr USAGE_INVALID
stderr 'Unknown command \\"help\\"'
env NCLY_JSON=1
exits 2 ncly -- help
! stdout .
answer stderr USAGE_INVALID
env NCLY_JSON=

# Help before -- still wins over the operands
exec ncly --help -- help nope
stdout 'Curated CLI toolbox'
! stderr .

# An installed extension's root and its commands are candidates too
install hello
exits 2 ncly helo --json
stderr 'Did you mean \\"hello\\"\?","hint":"ncly hello --help"'
exits 2 ncly hello chek --json
stderr 'Did you mean \\"check\\"\?","hint":"ncly hello check --help"'
