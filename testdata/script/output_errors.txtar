[!linux] skip 'needs /dev/full, which refuses every write'

# A failed write of the output is a runtime failure, never a success
exits 1 sh -c 'ncly --version >/dev/full'
stderr 'Could not write the output'
exits 1 sh -c 'ncly --version --json >/dev/full'
answer stderr RUNTIME
exits 1 sh -c 'ncly --help >/dev/full'
stderr 'Could not write the output'
exits 1 sh -c 'ncly >/dev/full'
stderr 'Could not write the output'

# The version succeeds when the output can be written
exec sh -c 'ncly --version >/dev/null'
! stderr .

# When stderr refuses the error answer too, ncly still exits 1 and never panics
exits 1 sh -c 'ncly nope 2>/dev/full'
! stdout .
exits 1 sh -c 'ncly nope --json 2>/dev/full'
! stdout .
exits 1 sh -c 'ncly --version --json >/dev/full 2>/dev/full'

# A completion script that cannot be written is a runtime failure, not a usage error
exits 1 sh -c 'ncly completion bash --json >/dev/full'
answer stderr RUNTIME
exits 1 sh -c 'ncly completion zsh --json >/dev/full'
answer stderr RUNTIME
exits 1 sh -c 'ncly completion fish --json >/dev/full'
answer stderr RUNTIME
