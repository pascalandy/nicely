summary = "shorthand.summary"

[[commands.flags]]
name = "accent"
shorthand = "é"
summary = "shorthand.summary"
-- broken/flagname.toml --
format_version = 1
contract_version = 1
domain = "flagname"

[[commands]]
path = "flagname"
summary = "flagname.summary"

[[commands.flags]]
name = "a=b"
summary = "flagname.summary"
-- broken/prefix.toml --
format_version = 1
contract_version = 1
domain = "prefix"

[[commands]]
path = "prefix"
summary = "prefix.summary"

[[errors]]
code = "GRUMPY"
exit = 1
-- broken/temporary.toml --
format_version = 1
contract_version = 1
domain = "temporary"

[[commands]]
path = "temporary"
summary = "temporary.summary"

[[errors]]
code = "TEMPORARY_LATER"
exit = 75
-- broken/catalog.toml --
format_version = 1
contract_version = 1
domain = "catalog"

[[commands]]
