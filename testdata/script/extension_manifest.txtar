-- mkdoctor.sh --
sh mkext.sh bin2 dok 'Check dok'
cat > bin2/ncly-dok.toml <<'TOML'
format_version = 1
contract_version = 1
domain = "dok"

[[commands]]
path = "dok"
summary = "dok.summary"

[[commands]]
path = "dok status"
summary = "dok.summary"
doctor = true
effects = { network = true }

[commands.result]
kind = "report"

[[commands.flags]]
name = "live"
summary = "dok.summary"

[[commands.flags]]
name = "timeout"
value = "duration"
variadic = true
summary = "dok.summary"
TOML
