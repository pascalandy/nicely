# Discovery reads the extensions folder of the data folder, then PATH in order.
# Every fixture appends its domain to $WORK/ran when it runs, and none may run.
env DATA=$WORK/.local/share/nicely/extensions
exec sh mkext.sh $DATA hello 'Greet from the data folder'
exec sh mkext.sh bin1 hello 'Greet from the first PATH folder'
exec sh mkext.sh bin2 hello 'Greet from the second PATH folder'
exec sh mkext.sh bin2 later 'Run later'
exec sh mkext.sh rel relative 'Run from a relative folder'
exec sh mkext.sh $WORK here 'Run from the current folder'
env PATH=rel:$WORK/bin1::$WORK/bin2:$PATH

# The data folder wins over PATH, and a relative or empty PATH entry is skipped
exec ncly --help
stdout '^EXTENSIONS$'
stdout '^  hello: +Greet from the data folder$'
stdout '^  later: +Run later$'
! stdout 'relative'
! stdout 'current folder'

# An earlier PATH folder wins over a later one
rm $DATA/ncly-hello
exec ncly --help
stdout '^  hello: +Greet from the first PATH folder$'
rm bin1/ncly-hello
exec ncly --help
stdout '^  hello: +Greet from the second PATH folder$'

# A link counts, and its manifest and catalog sit beside the link, never its target
mkdir target
cp stub.sh target/program
chmod 755 target/program
exec sh mkext.sh bin2 linked 'Run through a link'
rm bin2/ncly-linked
symlink bin2/ncly-linked -> ../target/program
exec ncly --help
stdout '^  linked: +Run through a link$'

# A file that the user may not execute, a reserved name, and a name that is no domain are skipped
exec sh mkext.sh bin2 plain 'Run without the right to'
chmod 644 bin2/ncly-plain
exec sh mkext.sh bin2 completion 'Replace the completion command'
exec sh mkext.sh bin2 tap 'Replace the tap command'
chmod 755 bin2/ncly-later.toml
exec ncly --help
! stdout 'without the right'
! stdout 'Replace'
! stdout 'later.toml'
exec ncly completion zsh
stdout '^#compdef ncly'
exits 2 ncly tap --json
answer stderr USAGE_INVALID

# Each broken extension answers EXTENSION_INVALID for its domain, and never runs
exec sh mkext.sh bin2 nomanifest 'Never shown'
rm bin2/ncly-nomanifest.toml
exits 78 ncly nomanifest --json
answer stderr EXTENSION_INVALID
stderr 'The extension nomanifest cannot run: ncly-nomanifest.toml is missing.'
stderr '"hint":"Fix or reinstall the extension at '

exec sh mkext.sh bin2 nocatalog 'Never shown'
rm bin2/ncly-nocatalog.locales/en.toml
exits 78 ncly nocatalog --json
answer stderr EXTENSION_INVALID
stderr 'ncly-nocatalog.locales/en.toml is missing'

exec sh mkext.sh bin2 template 'Never {{ shown'
exits 78 ncly template --json
answer stderr EXTENSION_INVALID
stderr 'ncly-template.locales/en.toml is not in the expected format'

exec sh mkext.sh bin2 empty ''
exits 78 ncly empty --json
answer stderr EXTENSION_INVALID
stderr 'ncly-empty.locales/en.toml is not in the expected format'

exec sh broken.sh syntax format contract domain parent jsonflag shorthand flagname prefix temporary catalog
exits 78 ncly syntax --json
answer stderr EXTENSION_INVALID
stderr 'ncly-syntax.toml has a TOML syntax error on line [0-9]+'
exits 78 ncly format --json
answer stderr EXTENSION_INVALID
stderr 'ncly-format.toml has format_version 2, and this ncly reads only 1'
exits 78 ncly contract --json
answer stderr EXTENSION_INVALID
stderr 'contract_version 2'
exits 78 ncly domain --json
answer stderr EXTENSION_INVALID
stderr 'declares the domain \\"other\\" instead of domain'
exits 78 ncly parent --json
answer stderr EXTENSION_INVALID
stderr 'without \\"parent profile\\" above it'
exits 78 ncly jsonflag --json
answer stderr EXTENSION_INVALID
stderr 'the flag --json'
exits 78 ncly shorthand --json
answer stderr EXTENSION_INVALID
stderr 'the shorthand \\"é\\"'
exits 78 ncly flagname --json
answer stderr EXTENSION_INVALID
stderr 'the name \\"a=b\\"'
exits 78 ncly prefix --json
answer stderr EXTENSION_INVALID
stderr 'the error code GRUMPY, which does not start with PREFIX_'
exits 78 ncly temporary --json
answer stderr EXTENSION_INVALID
stderr 'maps the error code TEMPORARY_LATER to exit 75'
exits 78 ncly catalog --json
answer stderr EXTENSION_INVALID
stderr 'lacks the ID \\"catalog.run.summary\\"'

# A manifest rejects a malformed service name in requires.keys, keychain and grants, which name
# checks of doctor, and a service named twice
exec sh broken.sh keyform keychain keygrants keytwice
exits 78 ncly keyform --json
answer stderr EXTENSION_INVALID
stderr 'lists \\"Deep-gram\\" in requires.keys of the command \\"keyform run\\"'
exits 78 ncly keychain --json
stderr 'lists \\"keychain\\" in requires.keys'
exits 78 ncly keygrants --json
stderr 'lists \\"grants\\" in requires.keys of the command \\"keygrants run\\", which must name a service once, in lowercase letters and digits that start with a letter, other than keychain and grants\.'
exits 78 ncly keytwice --json
stderr 'lists \\"deepgram\\" in requires.keys of the command \\"keytwice run\\"'

# The keys table holds only services that a command declares in requires.keys, and its optional
# is true or false
exec sh broken.sh keyunused keyoptional
exits 78 ncly keyunused --json
answer stderr EXTENSION_INVALID
stderr 'declares the service \\"openai\\" in keys, which must be a service that the requires.keys of a command names'
exits 78 ncly keyoptional --json
answer stderr EXTENSION_INVALID
stderr 'gives the service \\"deepgram\\" an optional that is neither true nor false'

# A manifest that takes --dry-run, --run-id, or the shorthand of --dry-run as an own flag is invalid
exec sh broken.sh dryrun runid nshort
exits 78 ncly dryrun --json
stderr 'the flag --dry-run, which a global flag'
exits 78 ncly runid --json
stderr 'the flag --run-id, which a global flag'
exits 78 ncly nshort --json
stderr 'the flag -n, which a global flag'

# Types, requiredness, variadic values, defaults, flag groups, and programs follow their rules
exec sh broken.sh typebad switchtype required variadic default switchdefault nandefault group bin bintwice program
exits 78 ncly typebad --json
stderr 'gives \\"count\\" of the command \\"typebad run\\" the type \\"float\\"'
exits 78 ncly switchtype --json
stderr 'gives \\"loud\\" of the command \\"switchtype run\\" the type \\"string\\"'
exits 78 ncly required --json
stderr 'makes \\"second\\" of the command \\"required run\\" required'
exits 78 ncly variadic --json
stderr 'makes \\"first\\" of the command \\"variadic run\\" take several values'
exits 78 ncly default --json
stderr 'gives the flag \\"count\\" of the command \\"default run\\" a default'
exits 78 ncly switchdefault --json
stderr 'gives the flag \\"loud\\" of the command \\"switchdefault run\\" a default'
exits 78 ncly nandefault --json
stderr 'gives the flag \\"limit\\" of the command \\"nandefault run\\" a default'

# Accepted values sit on an argument or a flag that takes a value, hold at least one value,
# each nonempty and once, and fit its type
exec sh broken.sh switchvalues typevalues twicevalues novalues blankvalue
exits 78 ncly switchvalues --json
stderr 'gives \\"loud\\" of the command \\"switchvalues run\\" values that do not fit it'
exits 78 ncly typevalues --json
stderr 'gives \\"count\\" of the command \\"typevalues run\\" values that do not fit it'
exits 78 ncly twicevalues --json
stderr 'gives \\"size\\" of the command \\"twicevalues run\\" values that do not fit it'
exits 78 ncly novalues --json
stderr 'gives \\"size\\" of the command \\"novalues run\\" values that do not fit it'
exits 78 ncly blankvalue --json
stderr 'gives \\"size\\" of the command \\"blankvalue run\\" values that do not fit it'
exits 78 ncly group --json
stderr 'the group of flags --left, --nope'
exits 78 ncly bin --json
stderr 'lists \\"ffmpeg\\" in requires.bins of the command \\"bin run\\"'
exits 78 ncly bintwice --json
stderr 'lists \\"curl\\" in requires.bins'
exits 78 ncly program --json
stderr 'declares the program \\"unused\\" in programs'

# A program's version is numbers joined by dots, its probe is not empty, and each of its
# install commands is not empty
exec sh broken.sh progversion progprobe proginstall
exits 78 ncly progversion --json
answer stderr EXTENSION_INVALID
stderr 'gives the program \\"curl\\" the version \\"v8\\", which must be numbers joined by dots'
exits 78 ncly progprobe --json
stderr 'gives the program \\"curl\\" an empty probe'
exits 78 ncly proginstall --json
stderr 'gives the program \\"curl\\" an empty install command for \\"brew\\"'

# Only the status command of its domain sets doctor, as Status command defines it
exec sh broken.sh dpath dgroup dkind darg dflag dreq dlive dtimeout dgroupflags dwrites dpaid deffects dnetwork dmode
exits 78 ncly dpath --json
stderr 'sets doctor on the command \\"dpath run\\"'
exits 78 ncly dgroup --json
stderr 'sets doctor on the command \\"dgroup status\\"'
exits 78 ncly dkind --json
stderr 'sets doctor on the command \\"dkind status\\"'
exits 78 ncly darg --json
stderr 'sets doctor on the command \\"darg status\\"'
exits 78 ncly dflag --json
stderr 'sets doctor on the command \\"dflag status\\"'
exits 78 ncly dreq --json
stderr 'sets doctor on the command \\"dreq status\\"'
exits 78 ncly dlive --json
stderr 'gives the flag \\"live\\" of the command \\"dlive status\\" a default'
exits 78 ncly dtimeout --json
stderr 'sets doctor on the command \\"dtimeout status\\"'
exits 78 ncly dgroupflags --json
stderr 'sets doctor on the command \\"dgroupflags status\\"'
exits 78 ncly dwrites --json
stderr 'sets doctor on the command \\"dwrites status\\"'
exits 78 ncly dpaid --json
stderr 'sets doctor on the command \\"dpaid status\\"'
exits 78 ncly deffects --json
stderr 'sets doctor on the command \\"deffects status\\"'
exits 78 ncly dnetwork --json
stderr 'sets doctor on the command \\"dnetwork status\\"'
exits 78 ncly dmode --json
stderr 'sets doctor on the command \\"dmode status\\"'
# The status command of its domain may set doctor, with live and timeout, even a variadic one,
# since the one value that doctor passes fits it
exec sh mkdoctor.sh
exec ncly dok status --help
stdout '--live'

# Each config key that a command reads lies under the domain, and appears once
exec sh broken.sh configkey
exits 78 ncly configkey --json
answer stderr EXTENSION_INVALID
stderr 'lists \\"lang\\" in config of the command \\"configkey run\\", which must name a key under configkey once'

# A schema describes an object with local references only, a text result has none, and
# only a command with dry run has dry_run_schema
exec sh broken.sh remoteref closedschema boolref badtype olddialect textschema dryschema
exits 78 ncly remoteref --json
answer stderr EXTENSION_INVALID
stderr 'gives the command \\"remoteref run\\" a schema that is not a JSON Schema of an object'
exits 78 ncly closedschema --json
stderr 'gives the command \\"closedschema run\\" a schema that is not a JSON Schema of an object'
exits 78 ncly boolref --json
stderr 'gives the command \\"boolref run\\" a schema that is not a JSON Schema of an object'
exits 78 ncly olddialect --json
stderr 'gives the command \\"olddialect run\\" a schema that is not a JSON Schema of an object'
exits 78 ncly badtype --json
stderr 'gives the command \\"badtype run\\" a schema that is not a JSON Schema of an object'
exec ncly --help
! stdout boolref
exits 78 ncly textschema --json
stderr 'gives the command \\"textschema run\\" a schema'
exits 78 ncly dryschema --json
stderr 'gives the command \\"dryschema run\\" a dry_run_schema'

# The text of the error comes from the catalog, and the help of a broken extension is the same error
exits 78 ncly --lang en-XA format
pseudo stderr format
exits 78 ncly format --help
stderr '^error\[EXTENSION_INVALID\]: The extension format cannot run'
exits 78 ncly help format
stderr '^error\[EXTENSION_INVALID\]'

# A broken extension stays its domain's extension and hides a valid one found later
exec sh mkext.sh $DATA later 'Run later from the data folder'
rm $DATA/ncly-later.toml
exits 78 ncly later --json
answer stderr EXTENSION_INVALID

# A domain without a verb prints its help, even when it declares no other command
exec ncly linked
stdout '^Run through a link$'

# The help lists the valid extensions beside the broken ones, which it leaves out
exec ncly --help
stdout '^  hello: '
stdout '^  linked: '
! stdout 'Never shown'
! stdout 'format'
! stdout '^  later:'
! exists ran

# values_from sits on an argument or a flag that takes a value, names a command, a key, and a
# field, and a command of its own domain only when that command qualifies: a list command
# that runs, takes no argument, answers an object, and declares effects that neither write
# user files nor bill. A foreign command is checked only when completion runs it
exec sh broken.sh vfok vfswitch vfempty vfundeclared vfgroup vfverb vfarg vfkind vfnoeffects vfwrites vfpaid
exec ncly vfok --help
stdout 'vfok'
exits 78 ncly vfswitch --json
answer stderr EXTENSION_INVALID
stderr 'gives the switch \\"loud\\" of the command \\"vfswitch run\\" a values_from'
exits 78 ncly vfempty --json
stderr 'gives \\"name\\" of the command \\"vfempty run\\" a values_from without its command, key, and field'
exits 78 ncly vfundeclared --json
stderr 'a values_from on \\"vfundeclared item missing list\\", which must be a list command'
exits 78 ncly vfgroup --json
stderr 'a values_from on \\"vfgroup item list\\", which must be a list command'
exits 78 ncly vfverb --json
stderr 'a values_from on \\"vfverb item show\\", which must be a list command'
exits 78 ncly vfarg --json
stderr 'a values_from on \\"vfarg item list\\", which must be a list command'
exits 78 ncly vfkind --json
stderr 'a values_from on \\"vfkind item list\\", which must be a list command'
exits 78 ncly vfnoeffects --json
stderr 'a values_from on \\"vfnoeffects item list\\", which must be a list command'
exits 78 ncly vfwrites --json
stderr 'a values_from on \\"vfwrites item list\\", which must be a list command'
exits 78 ncly vfpaid --json
stderr 'a values_from on \\"vfpaid item list\\", which must be a list command'

-- stub.sh --
#!/bin/sh
echo "${0##*/}" >> "$WORK/ran"
-- mkext.sh --
# mkext.sh <folder> <domain> <summary> writes a valid fixture extension.
dir=$1 domain=$2
mkdir -p "$dir/ncly-$domain.locales"
cp stub.sh "$dir/ncly-$domain"
chmod 755 "$dir/ncly-$domain"
cat > "$dir/ncly-$domain.toml" <<EOF
format_version = 1
contract_version = 1
domain = "$domain"

[[commands]]
path = "$domain"
summary = "$domain.summary"
EOF
cat > "$dir/ncly-$domain.locales/en.toml" <<EOF
["$domain.summary"]
description = "Summary of the fixture."
other = "$3"
EOF
-- broken.sh --
# broken.sh <domain>... writes fixtures whose manifest is broken/<domain>.toml.
for domain in "$@"; do
  sh mkext.sh bin2 "$domain" 'Never shown'
  cp "broken/$domain.toml" "bin2/ncly-$domain.toml"
done
-- broken/syntax.toml --
format_version = 1
contract_version = 1
domain = "syntax"
[[commands]
-- broken/format.toml --
format_version = 2
contract_version = 1
domain = "format"

[[commands]]
path = "format"
summary = "format.summary"
-- broken/contract.toml --
format_version = 1
contract_version = 2
domain = "contract"

[[commands]]
path = "contract"
summary = "contract.summary"
-- broken/domain.toml --
format_version = 1
contract_version = 1
domain = "other"

[[commands]]
path = "other"
summary = "domain.summary"
-- broken/parent.toml --
format_version = 1
contract_version = 1
domain = "parent"

[[commands]]
path = "parent"
summary = "parent.summary"

[[commands]]
path = "parent profile list"
summary = "parent.summary"
-- broken/jsonflag.toml --
format_version = 1
contract_version = 1
domain = "jsonflag"

[[commands]]
path = "jsonflag"
summary = "jsonflag.summary"

[[commands.flags]]
name = "json"
summary = "jsonflag.summary"
-- broken/shorthand.toml --
format_version = 1
contract_version = 1
domain = "shorthand"

[[commands]]
