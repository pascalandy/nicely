# The help of zsh shows the script loaded with eval, which goes after compinit because the script calls compdef
exec ncly completion zsh --help
stdout '^  \$ eval "\$\(ncly completion zsh\)"$'
! stdout 'autoload'

# zsh registers the completion when the script loads after compinit
[exec:zsh] exec zsh -f -c 'autoload -Uz compinit && compinit -u -d $WORK/zcompdump && eval "$(ncly completion zsh)" && print -r -- $_comps[ncly]'
[exec:zsh] stdout '\A_ncly\n\z'
[exec:zsh] ! stderr .
