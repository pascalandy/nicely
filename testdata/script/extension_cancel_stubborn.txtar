# The program runner ends what a signal does not: SIGKILL once cleanup ends, which
# the test binary shortens to 4 seconds. The drain limit keeps its 2 seconds and
# counts from the extension's exit, so it never cuts cleanup short.
chmod 755 bin/ncly-hello
env PATH=$WORK/bin:$PATH

# An extension that answers 3 seconds after Ctrl-C keeps its key under INTERRUPTED
exec exitcode exit.txt ncly hello late --json &
waitfile fixture.pid
kill -INT
wait
grep '^130$' exit.txt
answer stderr INTERRUPTED
stderr '"output_dir":"/Users/me/out"'
gone fixture.pid

# The reservation also stops the handler's cleanup child. Its diagnostic never
# enters the JSON stream; the handler answers before the final force-stop.
rm fixture.pid
exec exitcode exit.txt ncly hello cleanup-child --json &
waitfile fixture.pid
kill -INT
wait
grep '^130$' exit.txt
! stdout .
answer stderr INTERRUPTED
stderr '"output_dir":"/Users/me/out"'
! stderr Killed
exec cat cleanup-child.exit
stdout '^137\n$'
gone cleanup-child.pid
gone fixture.pid

# An extension that keeps running after Ctrl-C got the signal, and SIGKILL ends it once
# cleanup ends. A second Ctrl-C during cleanup changes nothing: it never reaches the
# extension, and core still answers INTERRUPTED
rm fixture.pid
exec exitcode exit.txt ncly hello stubborn --json &
waitfile fixture.pid
kill -INT
waitfile signals.txt
kill -INT
wait
grep '^130$' exit.txt
answer stderr INTERRUPTED
grep -count=1 '^INT$' signals.txt
gone fixture.pid

# An extension that answers at once keeps its key, although its child, which ignores the
# signal, writes on its stdout 3 seconds later: the drain limit counts from the
# extension's exit, so cleanup never lets a descendant write into the answer
rm fixture.pid
exec exitcode exit.txt ncly hello leaky --json &
waitfile fixture.pid
kill -INT
wait
grep '^130$' exit.txt
! stdout .
answer stderr INTERRUPTED
stderr '"output_dir":"/Users/me/out"'
gone fixture.pid

-- bin/ncly-hello --
#!/bin/sh
cleanup_child() {
  # A shell can print its wait diagnostic itself, so redirect the whole group.
  {
    sh cleanup-child.sh &
    child=$!
    wait "$child"
    result=$?
  } 2> "$WORK/cleanup-child.stderr"
  printf '%s\n' "$result" > "$WORK/cleanup-child.exit"
  echo '{"ok":true,"contract_version":1,"output_dir":"/Users/me/out"}'
  exit 0
}
case "$1" in
late)
  # Delay in the handler itself: core may force-stop descendant processes first.
  exec python3 late.py
  ;;
cleanup-child)
  trap cleanup_child INT TERM
  ;;
stubborn)
  trap 'echo INT >> "$WORK/signals.txt"' INT
  trap 'echo TERM >> "$WORK/signals.txt"' TERM
  ;;
leaky)
  trap 'echo "{\"ok\":true,\"contract_version\":1,\"output_dir\":\"/Users/me/out\"}"; exit 0' INT TERM
  (trap '' INT TERM; sleep 3; echo late) &
  ;;
esac
echo $$ > "$WORK/fixture.tmp"
mv "$WORK/fixture.tmp" "$WORK/fixture.pid"
while :; do sleep 0.1; done
-- cleanup-child.sh --
echo $$ > "$WORK/cleanup-child.tmp"
mv "$WORK/cleanup-child.tmp" "$WORK/cleanup-child.pid"
exec sleep 30
-- late.py --
import json
import os
import signal
import time
from pathlib import Path


def stop(_signal: int, _frame: object) -> None:
    time.sleep(3)
    print(
        json.dumps({"ok": True, "contract_version": 1, "output_dir": "/Users/me/out"})
    )
    raise SystemExit(0)


signal.signal(signal.SIGINT, stop)
signal.signal(signal.SIGTERM, stop)
folder = Path(os.environ["WORK"])
temporary = folder / "fixture.tmp"
temporary.write_text(f"{os.getpid()}\n", encoding="utf-8")
temporary.rename(folder / "fixture.pid")
while True:
    signal.pause()
-- bin/ncly-hello.toml --
format_version = 1
contract_version = 1
domain = "hello"

[[commands]]
path = "hello"
summary = "hello.summary"

[[commands]]
path = "hello late"
summary = "hello.late.summary"

[[commands]]
path = "hello cleanup-child"
summary = "hello.cleanup_child.summary"

[[commands]]
path = "hello stubborn"
summary = "hello.stubborn.summary"

[[commands]]
path = "hello leaky"
summary = "hello.leaky.summary"
-- bin/ncly-hello.locales/en.toml --
["hello.summary"]
description = "Summary of the fixture."
other = "Greet people"

["hello.late.summary"]
description = "Summary of hello late."
other = "Answer 3 seconds after a signal"

["hello.cleanup_child.summary"]
description = "Summary of hello cleanup-child."
other = "Answer after the cleanup child stops"

["hello.stubborn.summary"]
description = "Summary of hello stubborn."
other = "Keep running after a signal"

["hello.leaky.summary"]
description = "Summary of hello leaky."
other = "Answer at once, and leave a child that writes later"
