# A missing key without --run-id leaves the existing run files unchanged.
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=
env DEEPGRAM_API_KEY=
env NCLY_TEST_UV_CACHE=$WORK/cache
env NCLY_TEST_LAUNCHER=$WORK/unused.py
mkdir bin
chmod 755 bin/uv
chmod 755 bin/python3
onlyncly transcript-external
install transcript
env RUNS=$WORK/.local/state/nicely/runs
mkdir $RUNS
cp retained.lock $RUNS/retained.lock
exec /bin/ls -A $RUNS
cp stdout before.txt
exits 78 ncly transcript run youtube --url https://youtu.be/abc --json
answer stderr KEY_NOT_GRANTED
! stderr '"run_id"'
exec /bin/ls -A $RUNS
cmp stdout before.txt
cmp retained.lock $RUNS/retained.lock

-- retained.lock --
keep this existing lock file
-- bin/uv --
#!/bin/sh
echo 'uv 0.13.1'
-- bin/python3 --
#!/bin/sh
echo 'Python 3.13.1'
