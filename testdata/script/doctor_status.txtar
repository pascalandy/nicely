# Doctor runs the status command that an extension's manifest marks with doctor, after its
# probes, checks the whole answer, and lists its checks under the extension's component. The
# shell fixture's hello status records its arguments in args.txt, and STATUS steers its
# answer. Doctor lists a valid answer as it is, and in place of any other, one hello.status
# check.
chmod 755 bin/ncly-hello
chmod 755 bin/plain
onlyncly
env LANG= LC_ALL= LC_MESSAGES= NCLY_LANG=
env DEEPGRAM_API_KEY=
env STATE=$WORK/.local/state/nicely
mkdir $STATE
exec /bin/sh -c '/usr/bin/sed "s|@WORK@|$WORK|g" grants.tmpl > "$STATE/grants.json"'

# A warning passes as it is, after the probe, and doctor passes --timeout with the seconds
# left, rounded up, and --live=true only when its caller sets --live
env STATUS=warn
exec ncly doctor hello --json
stdout '\A\{"ok":true,"contract_version":1,"checks":\[\{"id":"hello\.plain","component":"hello","status":"pass","message":"plain found at '${WORK@R}'/bin/plain\."\},\{"id":"hello\.mood","component":"hello","status":"warn","code":"HELLO_SLEEPY","message":"Hello is sleepy\.","hint":"Let it rest\."\}\]\}\n\z'
grep '^status\n--timeout=30s\n--\n\z' args.txt
exec ncly doctor hello --live --timeout 10 --json
grep '^status\n--live=true\n--timeout=10s\n--\n\z' args.txt
grep '^NCLY_JSON=1$' env.txt
cp stdout warn.json
exec ncly describe doctor --json
cp stdout describe.json
schema warn.json describe.json schema

# A failed check with next passes as it is, and fails the report
env STATUS=fail
exits 78 ncly doctor hello --json
stdout '\{"id":"hello\.mood","component":"hello","status":"fail","code":"PREREQ_MISSING","message":"Hello needs coffee\.","hint":"brew install coffee","next":\["brew","install","coffee"\]\}\]\}$'

# A valid pass beside an entry of another component rejects the whole answer
env STATUS=mixed
exits 78 ncly doctor hello --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"EXTENSION_INVALID","message":"The status command of hello gave an answer that doctor rejects: its check 2, other\.mood of the component other, must belong to hello, with an id that starts with hello and a dot\.","hint":"Fix or reinstall the extension at '${WORK@R}'/bin/ncly-hello\."\}\]\}$'
! stdout 'All good'

# A failure whose code maps to 78 becomes its own check, and a failure with exit 1 is
# EXTENSION_INVALID
env STATUS=config
exits 78 ncly doctor hello --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"CONFIG_INVALID","message":"The hello table is broken\.","hint":"Fix the hello table\."\}\]\}$'
env STATUS=runtime
exits 78 ncly doctor hello --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"EXTENSION_INVALID","message":"The status command of hello failed with exit 1\.",'

# An answer without a checks array, a warning whose code breaks the form of a code, and a
# failure led by a code that maps to no exit are rejected too
env STATUS=nochecks
exits 78 ncly doctor hello --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"EXTENSION_INVALID","message":"The status command of hello gave an answer that doctor rejects: it holds no checks array\.",'
env STATUS=nullchecks
exits 78 ncly doctor hello --json
stdout '"message":"The status command of hello gave an answer that doctor rejects: it holds no checks array\.",'
env STATUS=lowercase
exits 78 ncly doctor hello --json
stdout '"message":"The status command of hello gave an answer that doctor rejects: its check 1, hello\.mood, has the status warn with the code \\"HELLO_sleepy\\":'
env STATUS=unmapped
exits 78 ncly doctor hello --json
stdout '"code":"EXTENSION_INVALID","message":"The status command of hello gave an answer that doctor rejects: it failed with OTHER_MISSING, which maps to no exit code of its domain\.",'
! stdout 'OTHER_MISSING","message'

# hello status declares deepgram, which a human granted to hello. Without --live, it receives
# no key, NCLY_MISSING_KEYS names no granted service, and the keychain gets no call. Under
# --live, it receives the key from the keychain
env STATUS=warn
cp seed.jsonl test-keychain.jsonl
exec ncly doctor hello --json
grep '\ANCLY_JSON=1\nNCLY_MISSING_KEYS unset\n\z' env.txt
cmp test-keychain.jsonl seed.jsonl
exec ncly doctor hello --live --json
grep '\ANCLY_JSON=1\nDEEPGRAM_API_KEY ff7506fc14da24862c1cf728498bc50ec3011e27ad4a16fbf4005281d9261db0\nNCLY_MISSING_KEYS unset\n\z' env.txt
grep -count=1 '"call":"get","account":"deepgram"\}' test-keychain.jsonl

# Under a keychain that never answers, doctor waits once, for the keychain's shortened limit,
# before it starts the status command, which then receives KEYRING_UNAVAILABLE for the key.
# The auth checks then find the keychain unavailable at once, without another call
cp seed.jsonl test-keychain.jsonl
env NCLY_TEST_KEYCHAIN=hang
exits 78 ncly doctor --live --json
grep '^NCLY_MISSING_KEYS=deepgram=KEYRING_UNAVAILABLE$' env.txt
stdout '\{"id":"hello\.mood","component":"hello","status":"warn",'
stdout '\{"id":"auth\.keychain","component":"auth","status":"warn","code":"KEYRING_ENV_ONLY",'
stdout '\{"id":"auth\.deepgram","component":"auth","status":"fail","code":"KEYRING_UNAVAILABLE",'
grep -count=1 '"call":"get"' test-keychain.jsonl

# A --timeout shorter than that limit fails hello.status with CHECK_TIMEOUT, and the command
# never starts, so it writes no args.txt
rm args.txt
exits 78 ncly doctor hello --live --timeout 1s --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"CHECK_TIMEOUT","message":"The keychain did not answer within --timeout, so hello status never started\.","hint":"Run ncly doctor again with a longer --timeout\."\}\]\}$'
! exists args.txt
env NCLY_TEST_KEYCHAIN=
env STATUS=

# --live may reach the network through a status command, so doctor declares that effect
exec ncly describe doctor --json
stdout '"effects":\{"user_writes":false,"network":true,"paid":false\}'

# An answer that never comes fails with CHECK_TIMEOUT, and the command dies at the limit
env STATUS=hang
exits 78 ncly doctor hello --timeout 1s --json
stdout '\{"id":"hello\.status","component":"hello","status":"fail","code":"CHECK_TIMEOUT","message":"The status command of hello did not answer within --timeout\.","hint":"Run ncly doctor again with a longer --timeout\."\}\]\}$'
gone status.pid
exits 78 ncly --lang en-XA doctor hello --timeout 1s
pseudo stdout hello.plain hello.status
env STATUS=

# With a broken manifest, doctor starts nothing for the extension and answers EXTENSION_INVALID
rm args.txt
cp broken.toml bin/ncly-hello.toml
exits 78 ncly doctor hello --json
answer stderr EXTENSION_INVALID
! stdout .
exits 78 ncly doctor --json
stdout '"id":"extensions\.hello","component":"extensions","status":"fail","code":"EXTENSION_INVALID"'
! stdout '"hello\.'
! exists args.txt

-- bin/ncly-hello --
#!/bin/sh
printf '%s\n' "$@" > "$WORK/args.txt"
echo "NCLY_JSON=$NCLY_JSON" > "$WORK/env.txt"
# The SHA-256 of the key that it receives, never the key, then NCLY_MISSING_KEYS
if [ -n "${DEEPGRAM_API_KEY:-}" ]; then
  if [ -x /usr/bin/sha256sum ]; then digest=$(printf '%s' "$DEEPGRAM_API_KEY" | /usr/bin/sha256sum); else digest=$(printf '%s' "$DEEPGRAM_API_KEY" | /usr/bin/shasum -a 256); fi
  echo "DEEPGRAM_API_KEY ${digest%% *}" >> "$WORK/env.txt"
fi
if [ "${NCLY_MISSING_KEYS+set}" = set ]; then echo "NCLY_MISSING_KEYS=$NCLY_MISSING_KEYS" >> "$WORK/env.txt"; else echo "NCLY_MISSING_KEYS unset" >> "$WORK/env.txt"; fi
case "$STATUS" in
warn)
  echo '{"ok":true,"contract_version":1,"checks":[{"id":"hello.mood","component":"hello","status":"warn","code":"HELLO_SLEEPY","message":"Hello is sleepy.","hint":"Let it rest."}]}'
  ;;
fail)
  echo '{"ok":false,"contract_version":1,"checks":[{"id":"hello.mood","component":"hello","status":"fail","code":"PREREQ_MISSING","message":"Hello needs coffee.","hint":"brew install coffee","next":["brew","install","coffee"]}]}'
  exit 78
  ;;
mixed)
  echo '{"ok":true,"contract_version":1,"checks":[{"id":"hello.mood","component":"hello","status":"pass","message":"All good."},{"id":"other.mood","component":"other","status":"pass","message":"All good."}]}'
  ;;
config)
  echo '{"ok":false,"contract_version":1,"errors":[{"code":"CONFIG_INVALID","message":"The hello table is broken.","hint":"Fix the hello table."}]}' >&2
  exit 78
  ;;
runtime)
  echo '{"ok":false,"contract_version":1,"errors":[{"code":"RUNTIME","message":"Broke.","hint":"Look."}]}' >&2
  exit 1
  ;;
nochecks)
  echo '{"ok":true,"contract_version":1}'
  ;;
nullchecks)
  echo '{"ok":true,"contract_version":1,"checks":null}'
  ;;
lowercase)
  echo '{"ok":true,"contract_version":1,"checks":[{"id":"hello.mood","component":"hello","status":"warn","code":"HELLO_sleepy","message":"Hello is sleepy.","hint":"Let it rest."}]}'
  ;;
unmapped)
  echo '{"ok":false,"contract_version":1,"errors":[{"code":"OTHER_MISSING","message":"Something else.","hint":"Look."}]}' >&2
  exit 78
  ;;
hang)
  echo $$ > "$WORK/status.pid"
  exec /bin/sleep 30
  ;;
esac
-- bin/ncly-hello.toml --
format_version = 1
contract_version = 1
domain = "hello"

[[commands]]
path = "hello"
summary = "hello.summary"

[[commands]]
path = "hello status"
summary = "hello.status.summary"
doctor = true
effects = { network = true }
requires = { bins = ["plain"], keys = ["deepgram"] }

[commands.result]
kind = "report"

[[commands.flags]]
name = "live"
summary = "hello.status.live"

[[commands.flags]]
name = "timeout"
value = "duration"
summary = "hello.status.timeout"

[programs.plain]
-- bin/ncly-hello.locales/en.toml --
["hello.summary"]
description = "Summary of the fixture."
other = "Greet people"

["hello.status.summary"]
description = "Summary of hello status."
other = "Check hello"

["hello.status.live"]
description = "Flag of hello status."
other = "Check the network too"

["hello.status.timeout"]
description = "Flag of hello status."
other = "Bound the checks"
-- seed.jsonl --
{"call":"set","account":"deepgram","key":"dg-stored"}
-- grants.tmpl --
{"format_version":1,"grants":[{"service":"deepgram","domain":"hello","path":"@WORK@/bin/ncly-hello","granted_at":"2026-10-17T04:00:00Z"}]}
-- broken.toml --
format_version = 1
contract_version = 1
domain = "other"
-- bin/plain --
#!/bin/sh
exit 0
