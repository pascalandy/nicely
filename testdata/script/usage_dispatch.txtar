# A validated call reaches the extension as canonical arguments: each value of a variadic
# flag as its own word, in the caller's order, commas kept, then --dry-run and --run-id
# after the own flags when the caller set them. The shell fixture appends its arguments
# to $WORK/ran. The Go fixture's hello pick answers with the call that its handler read.
chmod 755 bin/ncly-shop
env PATH=$WORK/bin:$PATH
install hello

# The shell fixture receives one --note word per value
exec ncly shop buy apple --note 'a,b' --store north --note c --cash --bag
grep '^shop buy --store=north --note=a,b --note=c --cash=true --bag=true -- apple$' ran

# --dry-run and --run-id follow the own flags, in that order, whatever the caller's order,
# and -n is --dry-run
rm ran
exec ncly shop buy apple --run-id r-1 -n --store north --cash --bag
grep '^shop buy --store=north --cash=true --bag=true --dry-run=true --run-id=r-1 -- apple$' ran

# The Go fixture's handler reads the values from Lists and the mode flags from Flags, through
# ncly, run directly, and bundled, and its dry run writes nothing
exec ncly hello pick Ada --tag 'a,b' --mood calm --left --tag c --dry-run --run-id r-1 --json
stdout '"flags":\{"dry-run":"true","left":"true","mood":"calm","run-id":"r-1"\}'
stdout '"lists":\{"tag":\["a,b","c"\]\}'
cp stdout through-ncly.json
exec ncly-hello pick Ada --tag 'a,b' --mood calm --left --tag c -n --run-id r-1 --json
cmp stdout through-ncly.json
exec ncly-bundled hello pick Ada --tag 'a,b' --mood calm --left --tag c --dry-run --run-id r-1 --json
cmp stdout through-ncly.json
! exists picked

# Without the mode flags, the handler runs for real
exec ncly hello pick Ada --mood calm --right --json
stdout '"flags":\{"mood":"calm","right":"true"\}'
stdout '"lists":\{\}'
exists picked

-- bin/ncly-shop --
#!/bin/sh
echo "shop $*" >> "$WORK/ran"
echo '{"ok":true,"contract_version":1}'
-- bin/ncly-shop.toml --
format_version = 1
contract_version = 1
domain = "shop"

[[commands]]
path = "shop"
summary = "shop.summary"

[[commands]]
path = "shop list"
summary = "shop.list.summary"
examples = ["ncly shop list", "ncly shop list --json"]

[[commands]]
path = "shop buy"
summary = "shop.buy.summary"
examples = ["ncly shop buy apple --store north --cash --bag", "ncly shop buy apple 3 --store north --card --box --json"]
effects = { user_writes = true, network = true }
modes = { dry_run = true, recorded = true }
requires = { bins = ["curl"], keys = ["shopapi"] }

[[commands.args]]
name = "item"
summary = "shop.buy.item"
required = true

[[commands.args]]
name = "quantity"
summary = "shop.buy.quantity"
type = "integer"

[[commands.flags]]
name = "store"
shorthand = "s"
value = "name"
required = true
summary = "shop.buy.store"

[[commands.flags]]
name = "budget"
value = "amount"
type = "number"
default = 10.5
summary = "shop.buy.budget"

[[commands.flags]]
name = "note"
value = "text"
variadic = true
summary = "shop.buy.note"

[[commands.flags]]
name = "cash"
summary = "shop.buy.cash"

[[commands.flags]]
name = "card"
summary = "shop.buy.card"

[[commands.flags]]
name = "email"
summary = "shop.buy.email"

[[commands.flags]]
name = "sms"
summary = "shop.buy.sms"

[[commands.flags]]
name = "bag"
summary = "shop.buy.bag"

[[commands.flags]]
name = "box"
summary = "shop.buy.box"

[[commands.flag_groups]]
flags = ["cash", "card"]
min = 1
max = 1

[[commands.flag_groups]]
flags = ["email", "sms"]
max = 1

[[commands.flag_groups]]
flags = ["bag", "box"]
min = 1

[programs.curl]
-- bin/ncly-shop.locales/en.toml --
["shop.summary"]
description = "Summary of the shop fixture."
other = "Buy things"

["shop.list.summary"]
description = "Summary of shop list."
other = "List the stores"

["shop.buy.summary"]
description = "Summary of shop buy."
other = "Buy an item"

["shop.buy.item"]
description = "The item argument of shop buy."
other = "Item to buy"

["shop.buy.quantity"]
description = "The quantity argument of shop buy."
other = "How many to buy"

["shop.buy.store"]
description = "The --store flag of shop buy."
other = "Store to buy from"

["shop.buy.budget"]
description = "The --budget flag of shop buy."
other = "Most to spend"

["shop.buy.note"]
description = "The --note flag of shop buy."
other = "Note for the store, once per flag"

["shop.buy.cash"]
description = "The --cash flag of shop buy."
other = "Pay cash"

["shop.buy.card"]
description = "The --card flag of shop buy."
other = "Pay by card"

["shop.buy.email"]
description = "The --email flag of shop buy."
other = "Send the receipt by email"

["shop.buy.sms"]
description = "The --sms flag of shop buy."
other = "Send the receipt by text message"

["shop.buy.bag"]
description = "The --bag flag of shop buy."
other = "Pack in a bag"

["shop.buy.box"]
description = "The --box flag of shop buy."
other = "Pack in a box"
